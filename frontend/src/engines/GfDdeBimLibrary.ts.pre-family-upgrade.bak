import * as THREE from 'three';

export interface BimConnection {
  id: string;
  type: 'suction' | 'discharge' | 'liquid' | 'oil' | 'gas';
  dn: number;
  pos: { x: number; y: number; z: number };
  dir: { x: number; y: number; z: number };
}

export interface BimPrimitive {
  type: 'box' | 'cylinder' | 'sphere' | 'torus';
  params: number[];
  pos: { x: number; y: number; z: number };
  rot: { x: number; y: number; z: number };
  mat: string;
}

export interface BimEquipmentDef {
  id: string;
  name: string;
  category: string;
  primitives: BimPrimitive[];
  connections: BimConnection[];
}

export const BIM_MATERIALS = {
  STAINLESS_STEEL: { color: 0xbdc3c7, metalness: 0.9, roughness: 0.1, envMapIntensity: 2.0 },
  CARBON_STEEL: { color: 0x7f8c8d, metalness: 0.7, roughness: 0.3 },
  PAINTED_RED: { color: 0xc0392b, metalness: 0.5, roughness: 0.4 },
  PAINTED_BLUE: { color: 0x2980b9, metalness: 0.5, roughness: 0.4 },
  MOTOR_BLACK: { color: 0x2c3e50, metalness: 0.6, roughness: 0.2 },
  INSULATION: { color: 0xecf0f1, metalness: 0.1, roughness: 0.9, transparent: true, opacity: 0.8 },
  GLASS: { color: 0xffffff, metalness: 0.1, roughness: 0.0, transparent: true, opacity: 0.3 }
};

