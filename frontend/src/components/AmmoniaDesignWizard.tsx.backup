// Types
interface AmmoniaProject {
    _id: string;
    projectInfo: {
        name: string;
        client?: string;
        location?: {
            city?: string;
            country?: string;
        };
    };
    currentPhase: string;
    phaseCompletion: {
        dataCollection: boolean;
        loadCalculation: boolean;
        equipmentSelection: boolean;
        calculationBook: boolean;
        pidDrawing: boolean;
        wiringDiagram: boolean;
        plcProgramming: boolean;
    };
    designData?: any;
    calculations?: any;
    equipmentSelection?: any;
    calculationBook?: any;
    pidDrawing?: any;
    wiringDiagram?: any;
    plcProgram?: any;
}

interface DesignWizardProps {
    chatId: string;
    onPhaseChange?: (phase: string) => void;
}

// Styled Components
const WizardContainer = styled(Paper)(({ theme }) => ({
    height: '100%',
    display: 'flex',
    flexDirection: 'column',
    overflow: 'hidden',
    backgroundColor: theme.palette.background.paper,
    borderRadius: theme.shape.borderRadius,
}));

const WizardHeader = styled(Box)(({ theme }) => ({
    padding: theme.spacing(2),
    borderBottom: `1px solid ${theme.palette.divider}`,
    backgroundColor: theme.palette.mode === 'dark' ? theme.palette.grey[900] : theme.palette.grey[50],
}));

const StepperContainer = styled(Box)(({ theme }) => ({
    padding: theme.spacing(2, 3),
    borderBottom: `1px solid ${theme.palette.divider}`,
    backgroundColor: theme.palette.background.paper,
}));

const ContentContainer = styled(Box)(({ theme }) => ({
    flexGrow: 1,
    overflow: 'auto',
    padding: theme.spacing(2),
    '&::-webkit-scrollbar': { width: '8px' },
    '&::-webkit-scrollbar-thumb': {
        backgroundColor: theme.palette.mode === 'dark' ? theme.palette.grey[700] : theme.palette.grey[400],
        borderRadius: '4px'
    }
}));

// Phase definitions
const phases = [
    { id: 'data_collection', label: 'Data Collection', icon: <CalculateIcon /> },
    { id: 'load_calculation', label: 'Load Calculation', icon: <CalculateIcon /> },
    { id: 'equipment_selection', label: 'Equipment Selection', icon: <DevicesIcon /> },
    { id: 'calculation_book', label: 'Calculation Book', icon: <DescriptionIcon /> },
    { id: 'pid_drawing', label: 'P&ID Drawing', icon: <AccountTreeIcon /> },
    { id: 'wiring_diagram', label: 'Wiring Diagram', icon: <ElectricalServicesIcon /> },
    { id: 'plc_programming', label: 'PLC Programming', icon: <MemoryIcon /> }
];

const AmmoniaDesignWizard: React.FC<DesignWizardProps> = ({ chatId, onPhaseChange }) => {
    const [project, setProject] = useState<AmmoniaProject | null>(null);
    const [loading, setLoading] = useState(true);
    const [activeStep, setActiveStep] = useState(0);
    const [selectedTier, setSelectedTier] = useState<'economic' | 'best' | 'premium'>('best');
    const [expandedSections, setExpandedSections] = useState<{ [key: string]: boolean }>({});

    // Load project data
    useEffect(() => {
        loadProjectData();
    }, [chatId]);

    const loadProjectData = async () => {
        try {
            setLoading(true);
            // Get or create project for this chat
            const response = await axios.get(`/api/ammonia-design/projects/by-chat/${chatId}`);
            setProject(response.data.project);
            
            // Set active step based on current phase
            const phaseIndex = phases.findIndex(p => p.id === response.data.project.currentPhase);
            if (phaseIndex >= 0) {
                setActiveStep(phaseIndex);
            }
        } catch (error: any) {
            console.error('Error loading project:', error);
            // If project doesn't exist, it will be created when user starts the wizard
        } finally {
            setLoading(false);
        }
    };

    const createDemoProject = async () => {
        try {
            setLoading(true);
            const response = await axios.post('/api/ammonia-design/create-demo');
            if (response.data.success) {
                setProject(response.data.project);
                setActiveStep(6); // Go to PLC Programming phase (last phase) to show all completed
                alert('✅ Complete Demo Loaded! Ardabil Poultry Slaughterhouse - All 7 phases completed.');
            }
        } catch (error: any) {
            console.error('Error creating demo project:', error);
            alert('Error creating demo project');
        } finally {
            setLoading(false);
        }
    };

    const handleStepClick = async (stepIndex: number) => {
        if (!project) return;

        // For demo projects (in-memory), just change the step locally
        if (project._id.startsWith('demo-project-')) {
            setActiveStep(stepIndex);
            if (onPhaseChange) {
                onPhaseChange(phases[stepIndex].id);
            }
            return;
        }

        // For real projects, update backend
        const newPhase = phases[stepIndex].id;
        try {
            await axios.put(`/api/ammonia-design/projects/${project._id}/phase`, {
                phase: newPhase
            });

            setActiveStep(stepIndex);
            if (onPhaseChange) {
                onPhaseChange(newPhase);
            }

            await loadProjectData();
        } catch (error) {
            console.error('Error changing phase:', error);
        }
    };

    const toggleSection = (section: string) => {
        setExpandedSections(prev => ({
            ...prev,
            [section]: !prev[section]
        }));
    };

    // Render phase content
    const renderPhaseContent = () => {
        if (!project) {
            return (
                <Box display="flex" flexDirection="column" alignItems="center" justifyContent="center" height="100%" gap={3}>
                    <Typography variant="h6" color="text.secondary" gutterBottom>
                        No Active Design Project
                    </Typography>
                    <Typography variant="body2" color="text.secondary" textAlign="center">
                        Start by chatting about your refrigeration requirements
                        <br />
                        or load a demo project to see how it works
                    </Typography>
                    <Button 
                        variant="contained" 
                        color="primary" 
                        onClick={createDemoProject}
                        startIcon={<CalculateIcon />}
                        size="large"
                    >
                        Load Demo Project
                    </Button>
                </Box>
            );
        }

        const currentPhase = phases[activeStep].id;

        switch (currentPhase) {
            case 'data_collection':
                return <DataCollectionView project={project} />;
            case 'load_calculation':
                return <LoadCalculationView project={project} />;
            case 'equipment_selection':
                return <EquipmentSelectionView project={project} selectedTier={selectedTier} onTierChange={setSelectedTier} />;
            case 'calculation_book':
                return <CalculationBookView project={project} />;
            case 'pid_drawing':
                return <PIDDrawingView project={project} />;
            case 'wiring_diagram':
                return <WiringDiagramView project={project} />;
            case 'plc_programming':
                return <PLCProgrammingView project={project} />;
            default:
                return <Typography>Select a phase to view details</Typography>;
        }
    };

    if (loading) {
        return (
            <WizardContainer>
                <Box display="flex" alignItems="center" justifyContent="center" height="100%">
                    <CircularProgress />
                </Box>
            </WizardContainer>
        );
    }

    return (
        <WizardContainer>
            {/* Header */}
            <WizardHeader>
                <Box>
                    <Typography variant="h6" fontWeight="bold">
                        Ammonia System Design
                    </Typography>
                    {project && (
                        <Typography variant="body2" color="text.secondary">
                            {project.projectInfo.name}
                        </Typography>
                    )}
                </Box>
                <Button
                    variant="outlined"
                    size="small"
                    onClick={createDemoProject}
                    startIcon={<CalculateIcon />}
                >
                    Load Demo
                </Button>
            </WizardHeader>

            {/* Progress Stepper */}
            <StepperContainer>
                <Stepper activeStep={activeStep} alternativeLabel nonLinear>
                    {phases.map((phase, index) => (
                        <Step key={phase.id} completed={project?.phaseCompletion[phase.id as keyof typeof project.phaseCompletion]}>
                            <StepButton onClick={() => handleStepClick(index)}>
                                <StepLabel
                                    StepIconComponent={() => (
                                        project?.phaseCompletion[phase.id as keyof typeof project.phaseCompletion] ? (
                                            <CheckCircleIcon color="success" />
                                        ) : (
                                            <RadioButtonUncheckedIcon color={index === activeStep ? 'primary' : 'disabled'} />
                                        )
                                    )}
                                >
                                    {phase.label}
                                </StepLabel>
                            </StepButton>
                        </Step>
                    ))}
                </Stepper>
            </StepperContainer>

            {/* Content */}
            <ContentContainer>
                {renderPhaseContent()}
            </ContentContainer>
        </WizardContainer>
    );
};

// ============================================================================
// Phase View Components
// ============================================================================

const DataCollectionView: React.FC<{ project: AmmoniaProject }> = ({ project }) => {
    const [userText, setUserText] = React.useState('');
    const [analyzing, setAnalyzing] = React.useState(false);
    const [analysisResult, setAnalysisResult] = React.useState<any>(
        (project as any).intelligentAnalysis || null  // Load from demo project if available
    );

    const handleIntelligentAnalysis = async () => {
        if (!userText.trim()) {
            alert('Please enter project description');
            return;
        }

        setAnalyzing(true);
        try {
            const response = await axios.post('/api/ammonia-design/intelligent-analyze', {
                chatId: 'demo-chat-1',
                userText: userText
            });

            if (response.data.success) {
                setAnalysisResult(response.data.analysis);
                alert('✅ Analysis complete! Check the results below.');
            }
        } catch (error: any) {
            console.error('Analysis error:', error);
            alert('Error: ' + (error.response?.data?.error || error.message));
        } finally {
            setAnalyzing(false);
        }
    };

    const data = project.designData;

    if (!data || Object.keys(data).length === 0) {
        return (
            <Box>
                <Alert severity="info" sx={{ mb: 2 }}>
                    Describe your refrigeration project requirements in detail. The AI will analyze and extract design parameters.
                </Alert>

                {/* Intelligent Input Section */}
                <Card sx={{ mb: 2 }}>
                    <CardContent>
                        <Typography variant="h6" gutterBottom>🤖 AI-Powered Design Analysis</Typography>
                        <Typography variant="body2" color="text.secondary" sx={{ mb: 2 }}>
                            Describe your project in natural language (Persian or English). Include room dimensions, temperatures, 
                            product flow, insulation, doors, etc.
                        </Typography>
                        
                        <TextField
                            multiline
                            rows={12}
                            fullWidth
                            variant="outlined"
                            placeholder="مثال: برام سردخانه‌های یک کشتارگاه مرغ رو طراحی کن، که یک سالن چیلینگ روم با ابعاد 20×8 متر و ارتفاع 4 متر داشته باشد برای دمای -5 درجه..."
                            value={userText}
                            onChange={(e) => setUserText(e.target.value)}
                            sx={{ mb: 2, fontFamily: 'monospace' }}
                        />

                        <Button
                            variant="contained"
                            color="primary"
                            onClick={handleIntelligentAnalysis}
                            disabled={analyzing || !userText.trim()}
                            startIcon={analyzing ? <CircularProgress size={20} /> : <CalculateIcon />}
                            fullWidth
                            size="large"
                        >
                            {analyzing ? 'Analyzing...' : 'Analyze with AI'}
                        </Button>
                    </CardContent>
                </Card>

                {/* Analysis Results */}
                {analysisResult && (
                    <Card>
                        <CardContent>
                            <Typography variant="h6" gutterBottom>✅ Analysis Results</Typography>
                            
                            {/* Summary */}
                            <Box sx={{ mb: 3, p: 2, bgcolor: 'success.light', borderRadius: 1 }}>
                                <Typography variant="subtitle1" fontWeight="bold" gutterBottom>
                                    {analysisResult.projectInfo?.name || 'Project'}
                                </Typography>
                                <Grid container spacing={2}>
                                    <Grid item xs={3}>
                                        <Typography variant="caption">Total Rooms</Typography>
                                        <Typography variant="h6">{analysisResult.summary.totalRooms}</Typography>
                                    </Grid>
                                    <Grid item xs={3}>
                                        <Typography variant="caption">Total Load</Typography>
                                        <Typography variant="h6">{analysisResult.summary.totalLoad} kW</Typography>
                                    </Grid>
                                    <Grid item xs={3}>
                                        <Typography variant="caption">Simultaneity</Typography>
                                        <Typography variant="h6">{(analysisResult.summary.simultaneityFactor * 100).toFixed(0)}%</Typography>
                                    </Grid>
                                    <Grid item xs={3}>
                                        <Typography variant="caption">Design Load</Typography>
                                        <Typography variant="h6" color="primary">{analysisResult.summary.designLoad} kW</Typography>
                                    </Grid>
                                </Grid>
                            </Box>

                            {/* Applied Standards & Regional Settings */}
                            {analysisResult.designCriteria && (
                                <Box sx={{ mb: 3, p: 2, bgcolor: 'info.light', borderRadius: 1 }}>
                                    <Typography variant="subtitle2" fontWeight="bold" gutterBottom>
                                        📋 Applied Standards & Regional Settings
                                    </Typography>
                                    <Grid container spacing={2}>
                                        <Grid item xs={6}>
                                            <Typography variant="caption" display="block" color="text.secondary">Region</Typography>
                                            <Typography variant="body2" fontWeight="bold">
                                                {analysisResult.designCriteria.region?.replace(/_/g, ' ').toUpperCase() || 'N/A'}
                                            </Typography>
                                        </Grid>
                                        <Grid item xs={6}>
                                            <Typography variant="caption" display="block" color="text.secondary">Safety Factor</Typography>
                                            <Typography variant="body2" fontWeight="bold">
                                                {analysisResult.designCriteria.safetyFactor || '1.15'}
                                            </Typography>
                                        </Grid>
                                        {analysisResult.designCriteria.standards && (
                                            <>
                                                <Grid item xs={6}>
                                                    <Typography variant="caption" display="block" color="text.secondary">Piping Standard</Typography>
                                                    <Typography variant="body2">{analysisResult.designCriteria.standards.piping}</Typography>
                                                </Grid>
                                                <Grid item xs={6}>
                                                    <Typography variant="caption" display="block" color="text.secondary">Safety Standard</Typography>
                                                    <Typography variant="body2">{analysisResult.designCriteria.standards.safety}</Typography>
                                                </Grid>
                                                <Grid item xs={6}>
                                                    <Typography variant="caption" display="block" color="text.secondary">Refrigeration Standard</Typography>
                                                    <Typography variant="body2">{analysisResult.designCriteria.standards.refrigeration}</Typography>
                                                </Grid>
                                                <Grid item xs={6}>
                                                    <Typography variant="caption" display="block" color="text.secondary">Electrical Standard</Typography>
                                                    <Typography variant="body2">{analysisResult.designCriteria.standards.electrical}</Typography>
                                                </Grid>
                                            </>
                                        )}
                                    </Grid>
                                </Box>
                            )}

                            {/* Room Details */}
                            <Typography variant="subtitle1" fontWeight="bold" gutterBottom>Room Load Details</Typography>
                            {analysisResult.roomDetails?.map((room: any, idx: number) => (
                                <Box key={idx} sx={{ mb: 2, p: 2, border: '1px solid', borderColor: 'divider', borderRadius: 1 }}>
                                    <Typography variant="body1" fontWeight="bold">{room.name} ({room.temperature}°C)</Typography>
                                    <Grid container spacing={2} sx={{ mt: 1 }}>
                                        <Grid item xs={3}>
                                            <Typography variant="caption" color="text.secondary">Transmission</Typography>
                                            <Typography variant="body2">{room.loads.transmission.toFixed(1)} kW</Typography>
                                        </Grid>
                                        <Grid item xs={3}>
                                            <Typography variant="caption" color="text.secondary">Product</Typography>
                                            <Typography variant="body2">{room.loads.product.toFixed(1)} kW</Typography>
                                        </Grid>
                                        <Grid item xs={3}>
                                            <Typography variant="caption" color="text.secondary">Infiltration</Typography>
                                            <Typography variant="body2">{room.loads.infiltration.toFixed(1)} kW</Typography>
                                        </Grid>
                                        <Grid item xs={3}>
                                            <Typography variant="caption" color="text.secondary">Total</Typography>
                                            <Typography variant="body2" fontWeight="bold">{room.loads.total.toFixed(1)} kW</Typography>
                                        </Grid>
                                    </Grid>
                                    
                                    {/* Evaporator Details */}
                                    {room.evaporators && room.evaporators.length > 0 && (
                                        <Box sx={{ mt: 2, p: 1, bgcolor: 'background.default', borderRadius: 1 }}>
                                            <Typography variant="caption" fontWeight="bold">Evaporators: {room.evaporators.length}x {room.evaporators[0].model}</Typography>
                                            <br />
                                            <Typography variant="caption" color="text.secondary">
                                                {room.evaporators[0].fans.quantity} fans × {room.evaporators[0].fans.motorPower} kW | 
                                                {room.evaporators[0].fans.airflow} m³/h | 
                                                Throw: {room.evaporators[0].fans.throwDistance}m | 
                                                Ø{room.evaporators[0].fans.diameter}mm
                                            </Typography>
                                        </Box>
                                    )}
                                </Box>
                            ))}

                            {/* Temperature Ranges */}
                            <Typography variant="subtitle1" fontWeight="bold" gutterBottom sx={{ mt: 3 }}>Temperature Range Groups</Typography>
                            {Object.entries(analysisResult.temperatureRanges || {}).map(([range, data]: [string, any]) => (
                                <Box key={range} sx={{ mb: 1, p: 1.5, bgcolor: 'primary.light', borderRadius: 1 }}>
                                    <Typography variant="body2" fontWeight="bold">
                                        {range.replace(/_/g, ' ').toUpperCase()}: {data.totalLoad.toFixed(1)} kW ({data.rooms.length} rooms)
                                    </Typography>
                                </Box>
                            ))}

                            {/* Compressor Configuration */}
                            <Typography variant="subtitle1" fontWeight="bold" gutterBottom sx={{ mt: 3 }}>Recommended Compressor Configuration</Typography>
                            {Object.entries(analysisResult.compressorConfiguration || {}).map(([range, config]: [string, any]) => (
                                <Box key={range} sx={{ mb: 2, p: 2, border: '1px solid', borderColor: 'primary.main', borderRadius: 1 }}>
                                    <Typography variant="body1" fontWeight="bold" color="primary">
                                        {range.replace(/_/g, ' ').toUpperCase()}
                                    </Typography>
                                    <Grid container spacing={2} sx={{ mt: 0.5 }}>
                                        <Grid item xs={3}>
                                            <Typography variant="caption">Base Count</Typography>
                                            <Typography variant="body2">{config.baseCount}</Typography>
                                        </Grid>
                                        <Grid item xs={3}>
                                            <Typography variant="caption">Reserve</Typography>
                                            <Typography variant="body2">+{config.reserveCount}</Typography>
                                        </Grid>
                                        <Grid item xs={3}>
                                            <Typography variant="caption">Total</Typography>
                                            <Typography variant="body2" fontWeight="bold">{config.totalCount}</Typography>
                                        </Grid>
                                        <Grid item xs={3}>
                                            <Typography variant="caption">Swing</Typography>
                                            <Typography variant="body2">{config.swingCapable ? '✅ Yes' : '❌ No'}</Typography>
                                        </Grid>
                                    </Grid>
                                    <Typography variant="caption" color="text.secondary" sx={{ mt: 1, display: 'block' }}>
                                        Capacity per unit: {config.capacityPerUnit} kW
                                    </Typography>
                                </Box>
                            ))}
                        </CardContent>
                    </Card>
                )}
            </Box>
        );
    }

    return (
        <Box>
            <Typography variant="h6" gutterBottom>Collected Data</Typography>

            {/* Ambient Conditions */}
            {data.ambient && (
                <Card sx={{ mb: 2 }}>
                    <CardContent>
                        <Typography variant="subtitle1" fontWeight="bold" gutterBottom>
                            Ambient Conditions
                        </Typography>
                        <Grid container spacing={2}>
                            <Grid item xs={6}>
                                <Typography variant="body2" color="text.secondary">Summer Temperature</Typography>
                                <Typography variant="body1">{data.ambient.summerTemp}°C</Typography>
                            </Grid>
                            <Grid item xs={6}>
                                <Typography variant="body2" color="text.secondary">Winter Temperature</Typography>
                                <Typography variant="body1">{data.ambient.winterTemp}°C</Typography>
                            </Grid>
                        </Grid>
                    </CardContent>
                </Card>
            )}

            {/* Cold Storage Rooms */}
            {data.rooms && data.rooms.length > 0 && (
                <Card>
                    <CardContent>
                        <Typography variant="subtitle1" fontWeight="bold" gutterBottom>
                            Cold Storage Rooms ({data.rooms.length})
                        </Typography>
                        {data.rooms.map((room: any, index: number) => (
                            <Box key={index} sx={{ mb: 2, p: 2, bgcolor: 'background.default', borderRadius: 1 }}>
                                <Typography variant="body1" fontWeight="bold">{room.name || `Room ${index + 1}`}</Typography>
                                <Grid container spacing={1} sx={{ mt: 1 }}>
                                    <Grid item xs={6}>
                                        <Typography variant="caption" color="text.secondary">Dimensions</Typography>
                                        <Typography variant="body2">
                                            {room.dimensions.length}m × {room.dimensions.width}m × {room.dimensions.height}m
                                        </Typography>
                                    </Grid>
                                    <Grid item xs={6}>
                                        <Typography variant="caption" color="text.secondary">Temperature</Typography>
                                        <Typography variant="body2">{room.temperature}°C</Typography>
                                    </Grid>
                                </Grid>
                            </Box>
                        ))}
                    </CardContent>
                </Card>
            )}
        </Box>
    );
};

const LoadCalculationView: React.FC<{ project: AmmoniaProject }> = ({ project }) => {
    // Try to get data from intelligentAnalysis first, then fallback to calculations
    const intelligentAnalysis = (project as any).intelligentAnalysis;
    const calc = project.calculations;
    
    // Use intelligent analysis if available
    if (intelligentAnalysis) {
        return (
            <Box>
                <Typography variant="h6" gutterBottom>📊 Refrigeration Load Analysis - Intelligent Design</Typography>
                
                {/* Project Header */}
                <Alert severity="success" sx={{ mb: 2 }}>
                    <Typography variant="subtitle1" fontWeight="bold">
                        {intelligentAnalysis.projectInfo?.name}
                    </Typography>
                    <Typography variant="body2">
                        {intelligentAnalysis.projectInfo?.location} - {intelligentAnalysis.projectInfo?.type}
                    </Typography>
                </Alert>

                {/* Regional Standards */}
                {intelligentAnalysis.designCriteria && (
                    <Card sx={{ mb: 2, bgcolor: 'info.light' }}>
                        <CardContent>
                            <Typography variant="subtitle1" fontWeight="bold" gutterBottom>
                                📋 Applied Design Standards
                            </Typography>
                            <Grid container spacing={2}>
                                <Grid item xs={4}>
                                    <Typography variant="caption" color="text.secondary">Region</Typography>
                                    <Typography variant="body2" fontWeight="bold">
                                        {intelligentAnalysis.designCriteria.region?.replace(/_/g, ' ').toUpperCase()}
                                    </Typography>
                                </Grid>
                                <Grid item xs={4}>
                                    <Typography variant="caption" color="text.secondary">Safety Factor</Typography>
                                    <Typography variant="body2" fontWeight="bold">
                                        {intelligentAnalysis.designCriteria.safetyFactor}
                                    </Typography>
                                </Grid>
                                <Grid item xs={4}>
                                    <Typography variant="caption" color="text.secondary">Units</Typography>
                                    <Typography variant="body2" fontWeight="bold">
                                        {intelligentAnalysis.designCriteria.units.toUpperCase()}
                                    </Typography>
                                </Grid>
                                {intelligentAnalysis.designCriteria.standards && (
                                    <>
                                        <Grid item xs={6}>
                                            <Typography variant="caption" color="text.secondary">Piping</Typography>
                                            <Typography variant="body2">{intelligentAnalysis.designCriteria.standards.piping}</Typography>
                                        </Grid>
                                        <Grid item xs={6}>
                                            <Typography variant="caption" color="text.secondary">Safety</Typography>
                                            <Typography variant="body2">{intelligentAnalysis.designCriteria.standards.safety}</Typography>
                                        </Grid>
                                        <Grid item xs={6}>
                                            <Typography variant="caption" color="text.secondary">Refrigeration</Typography>
                                            <Typography variant="body2">{intelligentAnalysis.designCriteria.standards.refrigeration}</Typography>
                                        </Grid>
                                        <Grid item xs={6}>
                                            <Typography variant="caption" color="text.secondary">Electrical</Typography>
                                            <Typography variant="body2">{intelligentAnalysis.designCriteria.standards.electrical}</Typography>
                                        </Grid>
                                    </>
                                )}
                            </Grid>
                        </CardContent>
                    </Card>
                )}

                {/* Summary Card */}
                <Card sx={{ mb: 2, bgcolor: 'success.main', color: 'success.contrastText' }}>
                    <CardContent>
                        <Grid container spacing={2} alignItems="center">
                            <Grid item xs={3}>
                                <Typography variant="h4" fontWeight="bold">
                                    {intelligentAnalysis.summary.totalRooms}
                                </Typography>
                                <Typography variant="caption">Rooms</Typography>
                            </Grid>
                            <Grid item xs={3}>
                                <Typography variant="h4" fontWeight="bold">
                                    {intelligentAnalysis.summary.totalLoad.toFixed(1)}
                                </Typography>
                                <Typography variant="caption">Total Load (kW)</Typography>
                            </Grid>
                            <Grid item xs={3}>
                                <Typography variant="h4" fontWeight="bold">
                                    {(intelligentAnalysis.summary.simultaneityFactor * 100).toFixed(0)}%
                                </Typography>
                                <Typography variant="caption">Simultaneity</Typography>
                            </Grid>
                            <Grid item xs={3}>
                                <Typography variant="h4" fontWeight="bold">
                                    {intelligentAnalysis.summary.designLoad.toFixed(1)}
                                </Typography>
                                <Typography variant="caption">Design Load (kW)</Typography>
                            </Grid>
                        </Grid>
                    </CardContent>
                </Card>

                {/* Temperature Range Groups */}
                <Card sx={{ mb: 2 }}>
                    <CardContent>
                        <Typography variant="subtitle1" fontWeight="bold" gutterBottom>
                            🌡️ Temperature Range Groups
                        </Typography>
                        {Object.entries(intelligentAnalysis.temperatureRanges || {}).map(([range, data]: [string, any]) => (
                            <Box key={range} sx={{ mb: 2, p: 2, bgcolor: 'primary.light', borderRadius: 1 }}>
                                <Grid container spacing={2} alignItems="center">
                                    <Grid item xs={6}>
                                        <Typography variant="body1" fontWeight="bold">
                                            {range.replace(/_/g, ' ').toUpperCase()}
                                        </Typography>
                                        <Typography variant="caption" color="text.secondary">
                                            {data.count} rooms
                                        </Typography>
                                    </Grid>
                                    <Grid item xs={6} textAlign="right">
                                        <Typography variant="h6" fontWeight="bold">
                                            {data.totalLoad.toFixed(1)} kW
                                        </Typography>
                                    </Grid>
                                </Grid>
                            </Box>
                        ))}
                    </CardContent>
                </Card>

                {/* Compressor Configuration */}
                <Card sx={{ mb: 2 }}>
                    <CardContent>
                        <Typography variant="subtitle1" fontWeight="bold" gutterBottom>
                            ⚙️ Compressor Configuration
                        </Typography>
                        {Object.entries(intelligentAnalysis.compressorConfiguration || {}).map(([range, config]: [string, any]) => (
                            <Box key={range} sx={{ mb: 2, p: 2, border: '1px solid', borderColor: 'divider', borderRadius: 1 }}>
                                <Typography variant="body1" fontWeight="bold" gutterBottom>
                                    {range.replace(/_/g, ' ').toUpperCase()}
                                </Typography>
                                <Grid container spacing={2}>
                                    <Grid item xs={6}>
                                        <Typography variant="caption" color="text.secondary">Total Load</Typography>
                                        <Typography variant="body2">{config.totalLoad.toFixed(1)} kW</Typography>
                                    </Grid>
                                    <Grid item xs={6}>
                                        <Typography variant="caption" color="text.secondary">Configuration</Typography>
                                        <Typography variant="body2" fontWeight="bold">{config.configuration}</Typography>
                                    </Grid>
                                    <Grid item xs={6}>
                                        <Typography variant="caption" color="text.secondary">Base Compressors</Typography>
                                        <Typography variant="body2">{config.baseCompressors}</Typography>
                                    </Grid>
                                    <Grid item xs={6}>
                                        <Typography variant="caption" color="text.secondary">Total Units</Typography>
                                        <Typography variant="body2">{config.totalUnits}</Typography>
                                    </Grid>
                                    <Grid item xs={12}>
                                        <Typography variant="caption" color="text.secondary">Capacity per Unit</Typography>
                                        <Typography variant="body2">{config.capacityPerUnit} kW</Typography>
                                    </Grid>
                                </Grid>
                            </Box>
                        ))}
                    </CardContent>
                </Card>

                {/* Room Details */}
                <Card>
                    <CardContent>
                        <Typography variant="subtitle1" fontWeight="bold" gutterBottom>
                            🏢 Detailed Room Analysis ({intelligentAnalysis.roomDetails?.length || 0} rooms)
                        </Typography>
                        <TableContainer>
                            <Table size="small">
                                <TableHead>
                                    <TableRow>
                                        <TableCell>Room Name</TableCell>
                                        <TableCell align="center">Temp (°C)</TableCell>
                                        <TableCell align="center">Type</TableCell>
                                        <TableCell align="right">Dimensions</TableCell>
                                        <TableCell align="right">Total Load (kW)</TableCell>
                                    </TableRow>
                                </TableHead>
                                <TableBody>
                                    {intelligentAnalysis.roomDetails?.map((room: any, idx: number) => (
                                        <TableRow key={idx} hover>
                                            <TableCell>{room.name}</TableCell>
                                            <TableCell align="center">
                                                <Chip label={room.temperature + '°C'} size="small" color={room.temperature < 0 ? 'primary' : 'default'} />
                                            </TableCell>
                                            <TableCell align="center">{room.type}</TableCell>
                                            <TableCell align="right">
                                                {room.dimensions.length}×{room.dimensions.width}×{room.dimensions.height}m
                                            </TableCell>
                                            <TableCell align="right">
                                                <Typography variant="body2" fontWeight="bold">
                                                    {room.loads.total.toFixed(1)}
                                                </Typography>
                                            </TableCell>
                                        </TableRow>
                                    ))}
                                </TableBody>
                            </Table>
                        </TableContainer>
                    </CardContent>
                </Card>
            </Box>
        );
    }

    // Fallback to old calculations format
    if (!calc) {
        return <Alert severity="warning">Load calculations not yet performed. Continue chatting to proceed.</Alert>;
    }

    return (
        <Box>
            <Typography variant="h6" gutterBottom>Refrigeration Load Summary</Typography>

            {/* Total Load Card */}
            <Card sx={{ mb: 2, bgcolor: 'primary.main', color: 'primary.contrastText' }}>
                <CardContent>
                    <Typography variant="h4" fontWeight="bold">
                        {calc.totalLoad?.toFixed(1)} kW
                    </Typography>
                    <Typography variant="body2">Total Design Load</Typography>
                </CardContent>
            </Card>

            {/* Load Breakdown */}
            <Card sx={{ mb: 2 }}>
                <CardContent>
                    <Typography variant="subtitle1" fontWeight="bold" gutterBottom>Load Breakdown</Typography>
                    <Table size="small">
                        <TableBody>
                            <TableRow>
                                <TableCell>Transmission Load</TableCell>
                                <TableCell align="right">{calc.transmissionLoad?.toFixed(1)} kW</TableCell>
                            </TableRow>
                            <TableRow>
                                <TableCell>Product Load</TableCell>
                                <TableCell align="right">{calc.productLoad?.toFixed(1)} kW</TableCell>
                            </TableRow>
                            <TableRow>
                                <TableCell>Infiltration Load</TableCell>
                                <TableCell align="right">{calc.infiltrationLoad?.toFixed(1)} kW</TableCell>
                            </TableRow>
                            <TableRow>
                                <TableCell>Internal Load</TableCell>
                                <TableCell align="right">{calc.internalLoad?.toFixed(1)} kW</TableCell>
                            </TableRow>
                            <TableRow>
                                <TableCell><strong>Subtotal</strong></TableCell>
                                <TableCell align="right">
                                    <strong>
                                        {(calc.transmissionLoad + calc.productLoad + calc.infiltrationLoad + calc.internalLoad).toFixed(1)} kW
                                    </strong>
                                </TableCell>
                            </TableRow>
                            <TableRow>
                                <TableCell>Safety Factor</TableCell>
                                <TableCell align="right">×{calc.safetyFactor}</TableCell>
                            </TableRow>
                            <TableRow sx={{ bgcolor: 'action.hover' }}>
                                <TableCell><strong>Total Design Load</strong></TableCell>
                                <TableCell align="right"><strong>{calc.totalLoad?.toFixed(1)} kW</strong></TableCell>
                            </TableRow>
                        </TableBody>
                    </Table>
                </CardContent>
            </Card>

            {/* Room by Room */}
            {calc.rooms && calc.rooms.length > 0 && (
                <Card>
                    <CardContent>
                        <Typography variant="subtitle1" fontWeight="bold" gutterBottom>Room by Room Analysis</Typography>
                        {calc.rooms.map((room: any, index: number) => (
                            <Box key={index} sx={{ mb: 2, p: 2, bgcolor: 'background.default', borderRadius: 1 }}>
                                <Typography variant="body1" fontWeight="bold">{room.roomId}</Typography>
                                <Typography variant="body2" color="text.secondary">
                                    Temperature: {room.temperature}°C | Load: {room.subtotal?.toFixed(1)} kW
                                </Typography>
                            </Box>
                        ))}
                    </CardContent>
                </Card>
            )}
        </Box>
    );
};

const EquipmentSelectionView: React.FC<{
    project: AmmoniaProject;
    selectedTier: 'economic' | 'best' | 'premium';
    onTierChange: (tier: 'economic' | 'best' | 'premium') => void;
}> = ({ project, selectedTier, onTierChange }) => {
    const equipment = project.equipmentSelection;

    if (!equipment) {
        return <Alert severity="warning">Equipment selection not yet performed. Continue with previous phases.</Alert>;
    }

    const tierData = equipment[selectedTier];

    return (
        <Box>
            <Typography variant="h6" gutterBottom>Equipment Selection</Typography>

            {/* Tier Selector */}
            <Tabs value={selectedTier} onChange={(_, val) => onTierChange(val)} sx={{ mb: 2 }}>
                <Tab label={`Economic - $${equipment.economic?.total?.toLocaleString()}`} value="economic" />
                <Tab label={`Best - $${equipment.best?.total?.toLocaleString()}`} value="best" />
                <Tab label={`Premium - $${equipment.premium?.total?.toLocaleString()}`} value="premium" />
            </Tabs>

            {/* Equipment List */}
            {tierData && tierData.items && (
                <TableContainer component={Paper}>
                    <Table>
                        <TableHead>
                            <TableRow>
                                <TableCell>Category</TableCell>
                                <TableCell>Equipment</TableCell>
                                <TableCell align="center">Qty</TableCell>
                                <TableCell align="right">Unit Price</TableCell>
                                <TableCell align="right">Total</TableCell>
                            </TableRow>
                        </TableHead>
                        <TableBody>
                            {tierData.items.map((item: any, index: number) => (
                                <TableRow key={index}>
                                    <TableCell>{item.category}</TableCell>
                                    <TableCell>{item.equipment?.model || item.equipment?.name || 'N/A'}</TableCell>
                                    <TableCell align="center">{item.quantity || 1}</TableCell>
                                    <TableCell align="right">${item.price?.toLocaleString()}</TableCell>
                                    <TableCell align="right">${((item.price || 0) * (item.quantity || 1)).toLocaleString()}</TableCell>
                                </TableRow>
                            ))}
                            <TableRow sx={{ bgcolor: 'action.hover' }}>
                                <TableCell colSpan={4}><strong>Total</strong></TableCell>
                                <TableCell align="right"><strong>${tierData.total?.toLocaleString()}</strong></TableCell>
                            </TableRow>
                        </TableBody>
                    </Table>
                </TableContainer>
            )}
        </Box>
    );
};

