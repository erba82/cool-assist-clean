# Copy this file to backend/.env. Keep real API keys only in backend/.env; never commit keys.
# The router chooses an eligible provider by task capability, modality, response health and observed latency.
# Its governed fallback order is NVIDIA NIM -> Gemini -> local DeepSeek/Ollama -> remote DeepSeek (only when configured).

PORT=5000

# AI router policy. Decisions are logged as provenance and learning proposals remain human-approved.
AI_ROUTER_ENABLED=true
AI_ROUTER_STRATEGY=capability-latency-provenance
AI_ROUTER_REQUEST_TIMEOUT_MS=30000
AI_ROUTER_MAX_FAILURES=2
AI_ROUTER_LEARNING_PROPOSALS=true

# Automatic agent learning database. Runtime events are persisted automatically;
# engineering rules, selection logic, safety settings and skills remain promotion-gated.
AGENT_LEARNING_DATABASE_URI=mongodb://127.0.0.1:27017/cool_assist
AGENT_LEARNING_COLLECTION=agent_learning_events

# NVIDIA NIM: one NVIDIA_API_KEY is used for all three hosted profiles.
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
# Use these official hosted model IDs; do not change them without provider verification.
NVIDIA_MODEL_ULTRA=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
NVIDIA_MODEL_NANO_OMNI=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# Default NVIDIA model for requests without a classified capability.
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# Google Gemini: stable multimodal fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# TokenRouter Qwen text fallback. Confirm the exact model alias with GET /v1/models after entering the key.
TOKENROUTER_API_KEY=
TOKENROUTER_API_BASE_URL=https://api.tokenrouter.com/v1
TOKENROUTER_QWEN_MODEL=qwen/qwen3.8-max

# DeepSeek remote fallback. Leave blank when local-only DeepSeek is intended.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Local DeepSeek through Ollama. This service must bind only to loopback.
DEEPSEEK_LOCAL_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=deepseek-r1:1.5b
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=10m

# Optional thermophysical-property provider. Default policy is no outbound call.
# Supported modes: none, coolprop-sidecar, refprop-sidecar.
# REFPROP requires an owner-approved license and controlled runtime.
THERMOPHYSICAL_PROVIDER_MODE=none
# When an owner-approved loopback sidecar is running, use http://127.0.0.1:5011.
THERMOPHYSICAL_PROVIDER_URL=
# Set true only after sidecar health, fluid mapping and reference-state tests pass.
THERMOPHYSICAL_PROVIDER_ALLOW_OUTBOUND=false
THERMOPHYSICAL_PROVIDER_REFERENCE_STATE=IIR
THERMOPHYSICAL_PROVIDER_TIMEOUT_MS=3000
# Runtime health governance is fail-closed: stale or unavailable health blocks property-dependent candidate work.
THERMOPHYSICAL_PROVIDER_HEALTH_INTERVAL_MS=30000
THERMOPHYSICAL_PROVIDER_HEALTH_STALE_AFTER_MS=90000
