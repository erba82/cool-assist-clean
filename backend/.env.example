# Copy this file to backend/.env and fill only the providers you intend to use.
# The routing order is NVIDIA NIM -> Gemini -> DeepSeek. Missing providers are skipped.

PORT=5000

# NVIDIA NIM (first priority)
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Google Gemini (second priority; either variable is accepted)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# DeepSeek (third priority)
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Optional thermophysical-property provider. Default policy is no outbound call.
# Supported modes: none, coolprop-sidecar, refprop-sidecar.
# REFPROP requires an owner-approved license and controlled runtime.
THERMOPHYSICAL_PROVIDER_MODE=none
THERMOPHYSICAL_PROVIDER_URL=
THERMOPHYSICAL_PROVIDER_ALLOW_OUTBOUND=false
THERMOPHYSICAL_PROVIDER_REFERENCE_STATE=IIR
