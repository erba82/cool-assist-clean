# Cool-Assist Backend Environment Variables

# ==============================================
# OPTIONAL: AI Features (Gemini)
# ==============================================
# Get your API key from: https://aistudio.google.com/app/apikey
# Gemini will be used first, Ollama as fallback
GOOGLE_API_KEY=
GEMINI_API_KEY=

# ==============================================
# OPTIONAL: Local AI Features (Ollama)
# ==============================================
# Ollama will be used as fallback when Gemini is unavailable
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b

# ==============================================
# OPTIONAL: Database
# ==============================================
# MongoDB (for future features)
MONGODB_URI=mongodb://localhost:27017/coolassist

# Neo4j (for knowledge graph - future)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ==============================================
# Server Configuration
# ==============================================
PORT=5000
NODE_ENV=development

# ==============================================
# CORS Settings
# ==============================================
# Frontend URL for CORS
FRONTEND_URL=http://localhost:3001
