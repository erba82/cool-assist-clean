import React, { Suspense, useEffect, useMemo, useRef } from 'react';
import { Canvas, useThree } from '@react-three/fiber';
import { ContactShadows, Environment, Grid, Html, OrbitControls, PerspectiveCamera } from '@react-three/drei';
import { Box, Typography } from '@mui/material';
import * as THREE from 'three';
import { buildSceneGraph, SceneGraph, SceneEquipment, ScenePort, Vec3 } from '../../engines/RefrigerationSceneEngine';
import { ThreeDModelFactory } from '../../engines/ThreeDModelFactory';

const SERVICE_LABEL: Record<string, string> = {
  suction: 'SUCTION', discharge: 'DISCHARGE', hotGas: 'HOT GAS', liquid: 'LIQUID', oil: 'OIL', defrost: 'DEFROST', water: 'WATER', default: 'PROCESS',
};

const vector = (point: Vec3) => new THREE.Vector3(point[0], point[1], point[2]);

const CameraFramer: React.FC<{ graph: SceneGraph }> = ({ graph }) => {
  const { camera } = useThree();
  const controls = useRef<any>(null);
  useEffect(() => {
    const points = [...graph.equipment.map(item => vector(item.position)), ...graph.pipes.flatMap(pipe => pipe.waypoints.map(vector))];
    if (!points.length) return;
    const bounds = new THREE.Box3();
    points.forEach(point => bounds.expandByPoint(point));
    const center = bounds.getCenter(new THREE.Vector3());
    const size = bounds.getSize(new THREE.Vector3());
    const span = Math.max(10, size.x, size.z);
    const distance = Math.max(16, span * 0.82);
    camera.position.set(center.x + distance * 0.92, Math.max(10, center.y + distance * 0.60), center.z + distance * 0.92);
    camera.near = 0.1;
    camera.far = 300;
    camera.updateProjectionMatrix();
    if (controls.current) {
      controls.current.target.copy(center);
      controls.current.update();
    } else {
      camera.lookAt(center);
    }
  }, [camera, graph]);
  return <OrbitControls ref={controls} makeDefault enableDamping dampingFactor={0.07} screenSpacePanning minDistance={3} maxDistance={90} />;
};

const Flange: React.FC<{ point: Vec3; dn: number; direction?: Vec3 }> = ({ point, dn, direction = [0, 1, 0] }) => {
  const radius = Math.max(0.045, Math.min(0.26, dn / 900));
  const normal = vector(direction).normalize();
  const quat = new THREE.Quaternion().setFromUnitVectors(new THREE.Vector3(0, 1, 0), normal);
  return <group position={vector(point)} quaternion={quat}>
    <mesh castShadow receiveShadow>
      <cylinderGeometry args={[radius * 1.36, radius * 1.36, 0.045, 20]} />
      <meshStandardMaterial color="#bdc3c7" metalness={0.92} roughness={0.19} />
    </mesh>
    {Array.from({ length: 8 }).map((_, index) => {
      const a = index * Math.PI / 4;
      return <mesh key={index} position={[Math.cos(a) * radius * 1.04, 0.035, Math.sin(a) * radius * 1.04]} castShadow>
        <cylinderGeometry args={[0.012, 0.012, 0.08, 8]} />
        <meshStandardMaterial color="#1f2937" metalness={0.88} roughness={0.23} />
      </mesh>;
    })}
  </group>;
};

const ProcessPipe: React.FC<{ pipe: SceneGraph['pipes'][number]; color: string }> = ({ pipe, color }) => {
  const segments = useMemo(() => pipe.waypoints.slice(0, -1).map((start, index) => {
    const end = pipe.waypoints[index + 1];
    const a = vector(start), b = vector(end);
    const direction = b.clone().sub(a);
    const length = direction.length();
    return {
      id: `${pipe.id}-segment-${index}`,
      midpoint: a.clone().add(b).multiplyScalar(0.5),
      length,
      quaternion: new THREE.Quaternion().setFromUnitVectors(new THREE.Vector3(0, 1, 0), direction.normalize()),
    };
  }).filter(item => item.length > 0.02), [pipe]);
  const insulated = pipe.service === 'suction' || pipe.service === 'liquid';
  const jacket = pipe.service === 'suction' ? '#e5e7eb' : '#d1d5db';

  return <group name={`pipe-${pipe.id}`}>
    {segments.map(segment => <group key={segment.id} position={segment.midpoint} quaternion={segment.quaternion}>
      {insulated && <mesh castShadow receiveShadow>
        <cylinderGeometry args={[pipe.radius * 1.46, pipe.radius * 1.46, Math.max(0.03, segment.length - 0.035), 24]} />
        <meshStandardMaterial color={jacket} metalness={0.15} roughness={0.68} />
      </mesh>}
      <mesh castShadow receiveShadow>
        <cylinderGeometry args={[pipe.radius, pipe.radius, segment.length, 24]} />
        <meshStandardMaterial color={color} metalness={0.86} roughness={0.22} envMapIntensity={1.2} />
      </mesh>
    </group>)}
    {pipe.waypoints.slice(1, -1).map((point, index) => <mesh key={`${pipe.id}-elbow-${index}`} position={vector(point)} castShadow receiveShadow>
      <sphereGeometry args={[insulated ? pipe.radius * 1.48 : pipe.radius * 1.1, 18, 16]} />
      <meshStandardMaterial color={insulated ? jacket : color} metalness={0.7} roughness={0.28} />
    </mesh>)}
    <Flange point={pipe.waypoints[0]} dn={pipe.dn} />
    <Flange point={pipe.waypoints[pipe.waypoints.length - 1]} dn={pipe.dn} />
    {pipe.waypoints.length > 4 && <Html position={vector(pipe.waypoints[Math.floor(pipe.waypoints.length / 2)])} center distanceFactor={13} style={{ pointerEvents: 'none' }}>
      <div style={{ color: '#f8fafc', background: 'rgba(15,23,42,.72)', border: `1px solid ${color}`, padding: '2px 5px', fontSize: 9, fontWeight: 800, whiteSpace: 'nowrap' }}>
        {SERVICE_LABEL[pipe.service] || 'PROCESS'} · DN{pipe.dn}
      </div>
    </Html>}
  </group>;
};

const PlantSupport: React.FC<{ support: SceneGraph['supports'][number] }> = ({ support }) => {
  const crossbarWidth = support.kind === 'trapeze' ? 1.1 : 0.22;
  return <group position={[support.position[0], 0, support.position[2]]}>
    <mesh castShadow receiveShadow position={[0, support.height / 2, 0]}>
      <boxGeometry args={[0.12, Math.max(0.2, support.height), 0.12]} />
      <meshStandardMaterial color="#475569" metalness={0.72} roughness={0.34} />
    </mesh>
    {support.kind === 'trapeze' && <mesh castShadow position={[0, support.height, 0]}>
      <boxGeometry args={[crossbarWidth, 0.10, 0.12]} />
      <meshStandardMaterial color="#475569" metalness={0.72} roughness={0.34} />
    </mesh>}
  </group>;
};

const RoomOutline: React.FC<{ room: SceneGraph['rooms'][number] }> = ({ room }) => <group position={[room.center[0], 0.02, room.center[2]]}>
  <mesh receiveShadow position={[0, -0.01, 0]}>
    <boxGeometry args={[room.width, 0.06, room.depth]} />
    <meshStandardMaterial color={room.type === 'cold-room' ? '#dbeafe' : '#cbd5e1'} transparent opacity={0.28} roughness={0.85} />
  </mesh>
  {room.type === 'machine-room' && <Html position={[0, 0.18, -room.depth / 2 + 0.5]} center distanceFactor={14} style={{ pointerEvents: 'none' }}>
    <div style={{ color: '#334155', fontSize: 10, fontWeight: 800, letterSpacing: 1.2, whiteSpace: 'nowrap' }}>{room.name.toUpperCase()}</div>
  </Html>}
</group>;

const EquipmentInstance: React.FC<{ item: SceneEquipment; factory: ThreeDModelFactory }> = ({ item, factory }) => {
  const placed = useMemo(() => factory.createEquipment(item.params.proId, item.params.tag, vector(item.position), new THREE.Euler(0, item.rotation || 0, 0)), [factory, item]);
  if (!placed) return null;
  return <group>
    <primitive object={placed.group} />
    {item.ports.map((port: ScenePort) => <Flange key={`${item.id}-${port.id}`} point={port.position} dn={port.dn} direction={port.direction} />)}
    <Html position={[item.position[0], item.position[1] + 2.1, item.position[2]]} center distanceFactor={8} style={{ pointerEvents: 'none' }}>
      <div style={{ color: '#f8fafc', background: 'rgba(15,23,42,.78)', border: '1px solid rgba(148,163,184,.8)', padding: '3px 6px', fontSize: 10, fontWeight: 800, whiteSpace: 'nowrap' }}>{item.params.tag}</div>
    </Html>
  </group>;
};

const TopologyIndustrialCanvas: React.FC<any> = ({ data, projectInfo }) => {
  const factory = useMemo(() => new ThreeDModelFactory(), []);
  const graph = useMemo(() => buildSceneGraph(data), [data]);
  const isEmpty = graph.equipment.length === 0;

  return <Box sx={{ width: '100%', height: '100%', minHeight: 620, position: 'relative', overflow: 'hidden', bgcolor: '#0f172a' }} data-engine="pid-topology-bim">
    <Canvas shadows dpr={[1, 2]} gl={{ antialias: true, toneMapping: THREE.ACESFilmicToneMapping, toneMappingExposure: 1.1 }}>
      <PerspectiveCamera makeDefault position={[18, 13, 20]} fov={39} />
      <CameraFramer graph={graph} />
      <color attach="background" args={['#0f172a']} />
      <fog attach="fog" args={['#0f172a', 38, 120]} />
      <ambientLight intensity={0.54} />
      <directionalLight position={[22, 28, 14]} intensity={1.48} castShadow shadow-mapSize={[2048, 2048]} />
      <directionalLight position={[-18, 15, -12]} intensity={0.32} />
      <hemisphereLight args={['#dbeafe', '#111827', 0.32]} />
      <Suspense fallback={null}><Environment preset="warehouse" /></Suspense>
      <Grid args={[Math.max(42, graph.room.width + 14), Math.max(42, graph.room.depth + 14)]} sectionSize={5} sectionThickness={1.25} sectionColor="#475569" cellColor="#243244" fadeDistance={85} position={[0, -0.03, 0]} />
      <ContactShadows position={[0, 0, 0]} scale={70} blur={2.2} far={28} opacity={0.45} />
      {graph.rooms.map(room => <RoomOutline key={room.id} room={room} />)}
      {isEmpty ? <Html center><div style={{ color: '#f8fafc', fontWeight: 800 }}>No P&amp;ID equipment data available for 3D conversion.</div></Html> : <group>
        {graph.equipment.map(item => <EquipmentInstance key={item.id} item={item} factory={factory} />)}
        {graph.pipes.map(pipe => <ProcessPipe key={pipe.id} pipe={pipe} color={graph.meta.colors[pipe.service] || graph.meta.colors.default} />)}
      </group>}
      {graph.supports.map(support => <PlantSupport key={support.id} support={support} />)}
    </Canvas>
    <Box sx={{ position: 'absolute', top: 14, left: 14, pointerEvents: 'none', bgcolor: 'rgba(15,23,42,.78)', border: '1px solid rgba(148,163,184,.45)', px: 1.2, py: 0.8 }}>
      <Typography variant="caption" sx={{ display: 'block', color: '#93c5fd', fontWeight: 900, letterSpacing: 1 }}>P&amp;ID TO BIM · PORT-CONNECTED</Typography>
      <Typography variant="body2" sx={{ color: '#f8fafc', fontWeight: 700 }}>{projectInfo?.projectName || data?.project?.name || 'Refrigeration Design'}</Typography>
      <Typography variant="caption" sx={{ color: '#cbd5e1' }}>{graph.meta.refrigerant} · {graph.meta.cycle} · {graph.equipment.length} assets · {graph.pipes.length} process lines</Typography>
    </Box>
  </Box>;
};

export default TopologyIndustrialCanvas;
