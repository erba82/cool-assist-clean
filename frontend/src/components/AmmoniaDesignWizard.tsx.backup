// ==============================================
// REFRIGERATION ENGINE - DIGITAL TWIN BRAIN
// Simplified for robustness and accuracy
// ==============================================

class RefrigerationEngine {
    /**
     * Calculate mass flow and pipe sizing
     * Simplified with robust defaults to prevent unit errors
     */
    static calculate(capacityKW: number, temp: number): { dn: number; massFlow: string; capacityKW: number } {
        // Safety: Ensure Capacity is not huge (Watts vs kW check)
        if (capacityKW > 10000) {
            console.warn(`Unit check: Converting ${capacityKW} to kW`);
            capacityKW = capacityKW / 1000;
        }

        // R717 Enthalpy diff approx: 1100 kJ/kg for typical conditions
        const massFlow = capacityKW / 1100; // kg/s
        
        // Suction Density approx at -40C: 0.3 kg/m3
        const density = 0.3;
        
        // Target Velocity: 12 m/s (IIAR standard for wet suction)
        const volFlow = massFlow / density;
        const area = volFlow / 12;
        const dia = Math.sqrt(4 * area / Math.PI) * 1000; // mm

        // DN Select
        const sizes = [25, 32, 40, 50, 65, 80, 100, 125, 150, 200, 250];
        const dn = sizes.find(s => s >= dia) || 250;

        return { dn, massFlow: massFlow.toFixed(2), capacityKW };
    }
}

// Ammonia Design Wizard - Intelligent Analysis Version

// ==============================================
// REFRIGERATION ENGINEERING MATH LIBRARY
// ==============================================

/**
 * Ammonia (R717) Thermodynamic Properties
 * ENHANCED: More complete tables for accurate refrigeration calculations
 */
const R717_TABLES = {
    // Temp (°C) : Enthalpy of Gas (h_g kJ/kg)
    enthalpyGas: {
        '-50': 1390, '-45': 1395, '-40': 1400, '-35': 1405, '-30': 1410, 
        '-25': 1415, '-20': 1420, '-10': 1430, '0': 1442, '10': 1452, 
        '30': 1468, '35': 1471, '40': 1474
    },
    // Temp (°C) : Enthalpy of Liquid (h_f kJ/kg)
    enthalpyLiquid: {
        '-50': 0, '-40': 43, '-30': 87, '-20': 131, '-10': 176, 
        '0': 221, '10': 268, '20': 315, '30': 363, '35': 387, '40': 411
    },
    // Temp (°C) : Specific Volume of Gas (v_g m³/kg)
    specificVolume: {
        '-50': 0.50, '-40': 0.37, '-30': 0.27, '-20': 0.21, '-10': 0.16, 
        '0': 0.13, '10': 0.10, '20': 0.08, '30': 0.07, '35': 0.06, '40': 0.05
    }
};

/**
 * Get interpolated property value
 * ENHANCED: More robust interpolation
 */
const getProperty = (propertyMap: any, temp: number): number => {
    const temps = Object.keys(propertyMap).map(Number).sort((a, b) => a - b);
    
    // If exact match
    if (propertyMap[temp.toString()]) {
        return propertyMap[temp.toString()];
    }
    
    // Out of bounds handling
    if (temp <= temps[0]) return propertyMap[temps[0]];
    if (temp >= temps[temps.length - 1]) return propertyMap[temps[temps.length - 1]];
    
    // Find surrounding temperatures for interpolation
    let lowerTemp = temps[0];
    let upperTemp = temps[temps.length - 1];
    
    for (let i = 0; i < temps.length - 1; i++) {
        if (temp > temps[i] && temp < temps[i + 1]) {
            lowerTemp = temps[i];
            upperTemp = temps[i + 1];
            break;
        }
    }
    
    // Linear interpolation: y = y1 + (x - x1) * (y2 - y1) / (x2 - x1)
    const lowerValue = propertyMap[lowerTemp.toString()];
    const upperValue = propertyMap[upperTemp.toString()];
    const fraction = (temp - lowerTemp) / (upperTemp - lowerTemp);
    
    return lowerValue + fraction * (upperValue - lowerValue);
};

/**
 * REFRIGERATION MATH HELPER - FIXED VERSION
 * CRITICAL FIX: Proper unit handling and sanity checks
 * Based on R717 enthalpy and density tables
 */
const RefrigerationMath = {
    /**
     * Calculate mass flow rate using proper enthalpy difference
     * m_dot = Q / Δh (Net Refrigerating Effect)
     * SANITY CHECK: For 200 kW at -40°C, m_dot should be ~0.2 kg/s NOT 200 kg/s
     */
    calculateMassFlow(capacity_kW: number, evapTemp: number, condensingTemp: number = 35): number {
        // UNIT CHECK: Ensure capacity is in kW
        if (capacity_kW > 100000) {
            console.warn(`⚠️ UNIT ERROR: Capacity ${capacity_kW} seems too high. Converting from W to kW.`);
            capacity_kW = capacity_kW / 1000;
        }
        
        // Get gas enthalpy at evaporator outlet (kJ/kg)
        const h_gas_evap = getProperty(R717_TABLES.enthalpyGas, evapTemp);
        // Get liquid enthalpy at condenser outlet (kJ/kg)
        const h_liq_cond = getProperty(R717_TABLES.enthalpyLiquid, condensingTemp);
        
        // Net Refrigerating Effect (NRE) in kJ/kg
        // For -40°C evap / +35°C cond: ~1400 - 387 = 1013 kJ/kg
        const nre = h_gas_evap - h_liq_cond;
        
        // SANITY CHECK
        if (nre < 800 || nre > 1500) {
            console.warn(`⚠️ NRE out of normal range: ${nre} kJ/kg. Check temperatures.`);
        }
        
        // Mass flow rate: m_dot = Q (kW) / Δh (kJ/kg) = kg/s
        // Example: 200 kW / 1000 kJ/kg = 0.2 kg/s ✅
        const massFlow = capacity_kW / nre;
        
        // FINAL SANITY CHECK
        if (massFlow > capacity_kW) {
            console.error(`🔴 CRITICAL ERROR: Mass flow (${massFlow} kg/s) > Capacity (${capacity_kW} kW). Unit mismatch!`);
        }
        
        return massFlow;
    },
    
    /**
     * Calculate pipe diameter based on volumetric flow and target velocity
     * Area (m²) = V_dot / velocity
     * Diameter (m) = sqrt(4 * Area / π)
     */
    calculatePipeDiameter(
        massFlow: number,
        density_kg_m3: number,
        targetVelocity: number
    ): { diameter_mm: number } {
        // Volumetric flow rate: V_dot = m_dot / ρ (m³/s)
        const volumeFlow = massFlow / density_kg_m3;
        
        // Required cross-sectional area: A = V_dot / velocity (m²)
        const area = volumeFlow / targetVelocity;
        
        // Diameter: D = sqrt(4A/π) (m)
        const diameter_m = Math.sqrt((4 * area) / Math.PI);
        const diameter_mm = diameter_m * 1000;
        
        return { diameter_mm };
    },
    
    
    /**
     * Select nearest standard DN size
     * DN50, DN80, DN100, DN150, DN200, DN250
     */
    selectStandardDN(calculated_mm: number): number {
        const standardDN = [50, 65, 80, 100, 125, 150, 200, 250, 300, 350, 400, 500];
        return standardDN.find(dn => dn >= calculated_mm) || 500;
    },
    
    
    /**
     * Calculate actual velocity with selected pipe size
     */
    calculateActualVelocity(
        massFlow: number,
        density_kg_m3: number,
        dn_mm: number
    ): number {
        const volumeFlow = massFlow / density_kg_m3; // m³/s
        const diameter_m = dn_mm / 1000;
        const area = Math.PI * Math.pow(diameter_m / 2, 2); // m²
        return volumeFlow / area; // m/s
    },
    
    
    /**
     * Complete pipe sizing calculation - DEBUGGED & FIXED
     * Returns DN size, actual velocity, mass flow, and volume flow
     * Uses DENSITY (ρ = 1/v) instead of specific volume for clarity
     */
    sizePipe(
        capacity_kW: number,
        evapTemp: number,
        condensingTemp: number,
        service: 'suction' | 'discharge' | 'liquid'
    ): { dn: number; velocity: number; massFlow: number; volumeFlow: number } {
        // Calculate mass flow (with unit checks)
        const massFlow = this.calculateMassFlow(capacity_kW, evapTemp, condensingTemp);
        
        // Get density and target velocity based on service
        let density_kg_m3: number; // Using density for clearer physics
        let targetVelocity: number;
        
        if (service === 'suction') {
            // Suction: low pressure, low density
            const specificVolume = getProperty(R717_TABLES.specificVolume, evapTemp); // m³/kg
            density_kg_m3 = 1 / specificVolume; // kg/m³
            targetVelocity = 10; // 10 m/s for wet suction (IIAR 2-2014)
        } else if (service === 'discharge') {
            // Discharge: high pressure, higher density
            const specificVolume = getProperty(R717_TABLES.specificVolume, condensingTemp);
            density_kg_m3 = (1 / specificVolume) * 1.25; // Higher density due to compression
            targetVelocity = 20; // 18-25 m/s for hot gas (IIAR 2-2014)
        } else {
            // Liquid line: very high density
            density_kg_m3 = 625; // kg/m³ for liquid ammonia at typical conditions
            targetVelocity = 1.2; // 1.0-1.5 m/s for liquid (IIAR 2-2014)
        }
        
        // Calculate required diameter
        const { diameter_mm } = this.calculatePipeDiameter(massFlow, density_kg_m3, targetVelocity);
        
        // Select standard DN
        const dn = this.selectStandardDN(diameter_mm);
        
        // Calculate actual velocity with selected size
        const actualVelocity = this.calculateActualVelocity(massFlow, density_kg_m3, dn);
        
        // Volumetric flow
        const volumeFlow = massFlow / density_kg_m3;
        
        // Logging for debug
        console.log(`📊 Pipe Sizing [${service}]: m_dot=${massFlow.toFixed(3)} kg/s, ρ=${density_kg_m3.toFixed(1)} kg/m³, DN${dn}, v=${actualVelocity.toFixed(1)} m/s`);
        
        return {
            dn,
            velocity: parseFloat(actualVelocity.toFixed(1)),
            massFlow: parseFloat(massFlow.toFixed(3)),
            volumeFlow: parseFloat(volumeFlow.toFixed(4))
        };
    },
    
    /**
     * Calculate Kv value for control valve sizing
     * Kv = flow / sqrt(ΔP)
     */
    calculateControlValveSize(
        lineDN: number,
        massFlow: number,
        targetPressureDrop_bar: number = 0.2
    ): number {
        // Control authority rule: valve typically 1-2 sizes smaller
        if (lineDN >= 150) return lineDN - 50;
        if (lineDN >= 100) return lineDN - 25;
        if (lineDN >= 50) return lineDN - 15;
        return lineDN;
    }
};

