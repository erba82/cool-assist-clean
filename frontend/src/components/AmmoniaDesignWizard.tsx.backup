                                                        <TableCell>{line.size}</TableCell>
                                                        <TableCell align="right">{line.velocity}</TableCell>
                                                    </TableRow>
                                                ))}
                                            </TableBody>
                                        </Table>
                                        <Typography variant="body2" sx={{ mt: 2 }}>Standards: {section.content.standards}</Typography>
                                        <Typography variant="body2">Material: {section.content.material}</Typography>
                                        <Typography variant="body2">Insulation: {section.content.insulationMaterial}</Typography>
                                    </Box>
                                )}
                            </Box>
                        )}
                    </CardContent>
                </Card>
            ))}
        </Box>
    );
};

const PIDDrawingView: React.FC<{ project: AmmoniaProject }> = ({ project }) => {
    const [diagram, setDiagram] = useState<{ nodes: any[], edges: any[] } | null>(null);
    const [logs, setLogs] = useState<string[]>([]);

    const generate = () => {
        const nodes: any[] = [];
        const edges: any[] = [];
        const newLogs: string[] = [];
        let id = 0;
        const getId = () => `n${id++}`;

        // --- SPACIOUS LAYOUT CONSTANTS ---
        const START_X = 100;
        const COMP_Y = 600;
        const COMP_GAP = 500; // Huge gap to prevent overlap
        const VALVE_GAP = 80; // Enough gap for 40px valves + labels

        // Get Data
        const compressors = project.equipmentSelection?.aboveZero?.compressors || [{ capacity: 200 }, { capacity: 200 }];
        
        // Create Separator (Top Left)
        const sepId = getId();
        nodes.push({
            id: sepId, type: 'vesselNode', position: { x: 100, y: 200 },
            data: { label: 'LP-SEP' }
        });

        // Create Condenser (Top Right)
        const condId = getId();
        nodes.push({
            id: condId, type: 'condenserNode', position: { x: 1200, y: 100 },
            data: { label: 'CONDENSER' }
        });

        // GENERATE COMPRESSOR RACK
        compressors.forEach((comp: any, idx: number) => {
            const cx = START_X + 300 + (idx * COMP_GAP);
            
            // Math Check
            const cap = Number(comp.capacity) || 200;
            const calc = RefrigerationEngine.calculate(cap, -40);
            newLogs.push(`Comp ${idx + 1}: ${calc.capacityKW.toFixed(1)} kW -> DN${calc.dn}`);

            // 1. Compressor Node
            const cId = getId();
            nodes.push({
                id: cId, type: 'compressorNode', position: { x: cx, y: COMP_Y },
                data: { label: `K-${idx + 1}`, subLabel: `DN${calc.dn}` }
            });

            // 2. Suction Train (Extending Left)
            const valves = ['SVA', 'FIA', 'ICS', 'SVA']; // Order: close to comp -> far
            let prevId: string = cId;
            
            valves.forEach((vType, vIdx) => {
                const vid = getId();
                // Position: Start from compressor, move left
                const vx = cx - 100 - (vIdx * VALVE_GAP); 
                
                nodes.push({
                    id: vid, type: 'valveNode', position: { x: vx, y: COMP_Y + 20 }, // Slightly lower to center
                    data: { 
                        label: `${vType}-${calc.dn}`, 
                        size: `DN${calc.dn}`,
                        type: vType === 'ICS' ? 'Control' : vType === 'FIA' ? 'Filter' : 'Stop'
                    }
                });

                // Edge
                edges.push({ 
                    id: getId(), source: vid, target: prevId, type: 'step', 
                    label: vIdx === 0 ? `DN${calc.dn}` : '' 
                });
                prevId = vid;
            });

            // Connect last suction valve to Separator
            edges.push({ 
                id: getId(), source: sepId, target: prevId, type: 'step', 
                label: 'Suction Header', style: { strokeDasharray: '5 5' }
            });

            // 3. Discharge Train (Extending Right)
            const dValves = ['NRVA', 'SVA'];
            prevId = cId;

            dValves.forEach((vType, vIdx) => {
                const vid = getId();
                const vx = cx + 100 + (vIdx * VALVE_GAP);
                
                nodes.push({
                    id: vid, type: 'valveNode', position: { x: vx, y: COMP_Y + 20 },
                    data: { 
                        label: `${vType}-${calc.dn}`, 
                        size: `DN${calc.dn}`,
                        type: vType === 'NRVA' ? 'Check' : 'Stop' 
                    }
                });

                edges.push({ id: getId(), source: prevId, target: vid, type: 'step' });
                prevId = vid;
            });

            // Connect last discharge valve to Condenser
            edges.push({ 
                id: getId(), source: prevId, target: condId, type: 'step', 
                label: 'Hot Gas' 
            });
        });

        console.log('✅ CAD P&ID Generated:', newLogs);
        setDiagram({ nodes, edges });
        setLogs(newLogs);
    };

    return (
        <Box sx={{ height: '100%', display: 'flex', flexDirection: 'column' }}>
            <Box sx={{ p: 2, display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                <Button variant="contained" onClick={generate} sx={{ bgcolor: '#10b981', '&:hover': { bgcolor: '#059669' } }}>
                    Generate CAD P&ID
                </Button>
                {logs.length > 0 && (
                    <Typography variant="caption" sx={{ fontFamily: 'monospace' }}>
                        {logs[logs.length - 1]}
                    </Typography>
                )}
            </Box>
            {diagram ? (
                <>
                    <Alert severity="success" sx={{ mx: 2, mb: 2 }}>
                        ✅ Generated {diagram.nodes.length} CAD symbols with 40px micro valves and 500px compressor spacing
                    </Alert>
                    <Box sx={{ flexGrow: 1 }}>
                        <PIDDrawingEngine nodes={diagram.nodes} edges={diagram.edges} />
                    </Box>
                </>
            ) : (
                <Box sx={{ flexGrow: 1, display: 'flex', alignItems: 'center', justifyContent: 'center', bgcolor: '#f5f5f5' }}>
                    <Typography variant="h6" color="text.secondary">Click "Generate CAD P&ID" to start</Typography>
                </Box>
            )}
        </Box>
    );
};

const WiringDiagramView: React.FC<{ project: AmmoniaProject }> = ({ project }) => {
    const wiring = project.wiringDiagram;
    const [isGenerating, setIsGenerating] = useState(false);

    const handleGenerateWiring = () => {
        setIsGenerating(true);
        
        const equipment = project.equipmentSelection;
        if (!equipment) {
            alert('Please complete equipment selection first');
            setIsGenerating(false);
            return;
        }

        // Generate wiring diagram from actual equipment
        let layoutData = `WIRING DIAGRAM - ${project.projectInfo?.name || 'Ammonia Refrigeration System'}\n`;
        layoutData += `==================================\n\n`;
        layoutData += `MAIN POWER DISTRIBUTION:\n\n`;

        let xPos = 50;
        let yPos = 100;
        const ySpacing = 100;
        const xSpacing = 150;

        // Power supply
        layoutData += `COMPONENT "Main Power Supply 3-Phase 480VAC" ${xPos},${yPos} id="PWR-001" type="power"\n`;
        xPos += xSpacing;

        // Main distribution panel
        layoutData += `COMPONENT "Main Distribution Panel MDP-01" ${xPos},${yPos} id="MDP-01" type="panel"\n`;
        xPos += xSpacing;

        // PLC
        layoutData += `COMPONENT "Allen Bradley PLC" ${xPos},${yPos} id="PLC-01" type="controller"\n`;
        
        // Add compressor circuits
        if (equipment.aboveZero?.compressors) {
            equipment.aboveZero.compressors.forEach((comp: any, idx: number) => {
                yPos += ySpacing;
                xPos = xSpacing * 2;
                layoutData += `COMPONENT "${comp.type} Starter" ${xPos},${yPos} id="START-K${idx + 401}" type="starter"\n`;
                xPos += xSpacing;
                layoutData += `COMPONENT "${comp.type} Motor" ${xPos},${yPos} id="M-K${idx + 401}" type="motor"\n`;
            });
        }

        // Add condenser fan circuits
        if (equipment.aboveZero?.condensers) {
            equipment.aboveZero.condensers.forEach((cond: any, idx: number) => {
                yPos += ySpacing;
                xPos = xSpacing * 2;
                layoutData += `COMPONENT "Condenser Fan ${idx + 1} Starter" ${xPos},${yPos} id="START-E${idx + 301}" type="starter"\n`;
                xPos += xSpacing;
                layoutData += `COMPONENT "Fan Motor ${idx + 1}" ${xPos},${yPos} id="M-E${idx + 301}" type="motor"\n`;
            });
        }

        // Add wiring connections
        layoutData += `\nELECTRICAL CONNECTIONS:\n\n`;
        layoutData += `WIRE sourceId="PWR-001" targetId="MDP-01" wireType="power" label="480V 3-Phase (Red/Black/Blue)"\n`;
        layoutData += `WIRE sourceId="MDP-01" targetId="PLC-01" wireType="control" label="24VDC Control Power"\n`;

        // Compressor wiring
        if (equipment.aboveZero?.compressors) {
            equipment.aboveZero.compressors.forEach((comp: any, idx: number) => {
                const starterId = `START-K${idx + 401}`;
                const motorId = `M-K${idx + 401}`;
                layoutData += `WIRE sourceId="MDP-01" targetId="${starterId}" wireType="power" label="480V Main Power"\n`;
                layoutData += `WIRE sourceId="PLC-01" targetId="${starterId}" wireType="control" label="Start/Stop Signal"\n`;
                layoutData += `WIRE sourceId="${starterId}" targetId="${motorId}" wireType="power" label="Motor Power L1/L2/L3"\n`;
            });
        }

        // Condenser fan wiring
        if (equipment.aboveZero?.condensers) {
            equipment.aboveZero.condensers.forEach((cond: any, idx: number) => {
                const starterId = `START-E${idx + 301}`;
                const motorId = `M-E${idx + 301}`;
                layoutData += `WIRE sourceId="MDP-01" targetId="${starterId}" wireType="power" label="480V Power"\n`;
                layoutData += `WIRE sourceId="PLC-01" targetId="${starterId}" wireType="control" label="Fan Control"\n`;
                layoutData += `WIRE sourceId="${starterId}" targetId="${motorId}" wireType="power" label="Fan Motor Power"\n`;
            });
        }

        const wiringData = {
            layout: layoutData,
            description: `Electrical wiring diagram for ${project.projectInfo?.name || 'ammonia refrigeration system'} including main power distribution, motor starters, and PLC control circuits.`
        };

        localStorage.setItem('wiringDiagramData', JSON.stringify(wiringData));
        window.open('/wiring-diagram', '_blank');
        setIsGenerating(false);
    };

    return (
        <Box>
            <Typography variant="h6" gutterBottom>⚡ Electrical Wiring Diagram</Typography>
            
            {/* Always show generate button */}
            <Box sx={{ mb: 3 }}>
                <Button 
                    variant="contained" 
                    color="primary"
                    onClick={handleGenerateWiring}
                    disabled={isGenerating || !project.equipmentSelection}
                    startIcon={isGenerating ? <CircularProgress size={20} /> : null}
                    sx={{ bgcolor: '#6366f1', '&:hover': { bgcolor: '#4f46e5' } }}
                >
                    {isGenerating ? 'Generating Wiring...' : 'Generate Wiring Diagram'}
                </Button>
                {!project.equipmentSelection && (
                    <Typography variant="body2" color="text.secondary" sx={{ mt: 2 }}>
                        Complete equipment selection first to generate wiring diagram.
                    </Typography>
                )}
            </Box>
            
            {wiring && wiring.generated && (
                <>
                    <Alert severity="success" sx={{ mb: 2 }}>
                        Last Generated: {new Date(wiring.generatedDate).toLocaleString()}
                    </Alert>

            {/* Main Panels */}
            {wiring.mainPanels && (
                <Card sx={{ mb: 2 }}>
                    <CardContent>
                        <Typography variant="subtitle1" fontWeight="bold" gutterBottom>📦 Main Electrical Panels</Typography>
                        {wiring.mainPanels.map((panel: any, idx: number) => (
                            <Box key={idx} sx={{ mb: 1, p: 1.5, bgcolor: 'primary.light', borderRadius: 1 }}>
                                <Typography variant="body1" fontWeight="bold">{panel.tag}</Typography>
                                <Typography variant="body2">{panel.type} - {panel.location}</Typography>
                                <Typography variant="body2" color="text.secondary">
                                    {panel.rating || panel.cpu}
                                </Typography>
                            </Box>
                        ))}
                    </CardContent>
                </Card>
            )}

            {/* Power Distribution */}
            {wiring.powerDistribution && (
                <Card sx={{ mb: 2 }}>
                    <CardContent>
                        <Typography variant="subtitle1" fontWeight="bold" gutterBottom>🔌 Power Distribution</Typography>
                        <TableContainer>
                            <Table size="small">
                                <TableHead>
                                    <TableRow>
                                        <TableCell>Equipment</TableCell>
                                        <TableCell>Motor</TableCell>
                                        <TableCell>Starter</TableCell>
                                        <TableCell>Cable</TableCell>
                                        <TableCell>Protection</TableCell>
                                    </TableRow>
                                </TableHead>
                                <TableBody>
                                    {wiring.powerDistribution.map((item: any, idx: number) => (
                                        <TableRow key={idx}>
                                            <TableCell>{item.equipment}</TableCell>
                                            <TableCell>{item.motor}</TableCell>
                                            <TableCell>{item.starter}</TableCell>
                                            <TableCell><Chip label={item.cable} size="small" /></TableCell>
                                            <TableCell>{item.protection}</TableCell>
                                        </TableRow>
                                    ))}
                                </TableBody>
                            </Table>
                        </TableContainer>
                    </CardContent>
                </Card>
            )}

            {/* Control Wiring */}
            {wiring.controlWiring && (
                <Card sx={{ mb: 2 }}>
                    <CardContent>
                        <Typography variant="subtitle1" fontWeight="bold" gutterBottom>🔌 Control & Signal Wiring</Typography>
                        <TableContainer>
                            <Table size="small">
                                <TableHead>
                                    <TableRow>
                                        <TableCell>Device</TableCell>
                                        <TableCell>Signal Type</TableCell>
                                        <TableCell>Destination</TableCell>
                                        <TableCell>Cable</TableCell>
                                    </TableRow>
                                </TableHead>
                                <TableBody>
                                    {wiring.controlWiring.map((item: any, idx: number) => (
                                        <TableRow key={idx}>
                                            <TableCell>{item.instrument || item.valve}</TableCell>
                                            <TableCell><Chip label={item.signal} size="small" color="info" /></TableCell>
                                            <TableCell>{item.destination}</TableCell>
                                            <TableCell>{item.cable}</TableCell>
                                        </TableRow>
                                    ))}
                                </TableBody>
                            </Table>
                        </TableContainer>
                    </CardContent>
                </Card>
            )}

            {/* Network Cabling */}
            {wiring.networkCabling && (
                <Card>
                    <CardContent>
                        <Typography variant="subtitle1" fontWeight="bold" gutterBottom>🌐 Network & Communication</Typography>
                        {wiring.networkCabling.map((item: any, idx: number) => (
                            <Box key={idx} sx={{ mb: 1, p: 1, border: '1px solid', borderColor: 'divider', borderRadius: 1 }}>
                                <Typography variant="body2">
                                    {item.from} → {item.to}
                                </Typography>
                                <Typography variant="caption" color="text.secondary">
                                    {item.type} | {item.cable}
                                </Typography>
                            </Box>
                        ))}
                    </CardContent>
                </Card>
            )}
                </>
            )}
        </Box>
    );
};

const PLCProgrammingView: React.FC<{ project: AmmoniaProject }> = ({ project }) => {
    const plc = project.plcProgram;

    if (!plc || !plc.generated) {
        return <Alert severity="warning">PLC program not yet generated.</Alert>;
    }

    return (
        <Box>
            <Typography variant="h6" gutterBottom>💻 PLC Programming - Control Logic</Typography>
            
            <Alert severity="success" sx={{ mb: 2 }}>
                Generated on: {new Date(plc.generatedDate).toLocaleString()}
            </Alert>

            {/* Platform Info */}
            <Card sx={{ mb: 2, bgcolor: 'primary.light' }}>
                <CardContent>
                    <Grid container spacing={2}>
                        <Grid item xs={6}>
                            <Typography variant="caption" color="text.secondary">Platform</Typography>
                            <Typography variant="h6">{plc.platform}</Typography>
                        </Grid>
                        <Grid item xs={6}>
                            <Typography variant="caption" color="text.secondary">CPU Model</Typography>
                            <Typography variant="h6">{plc.cpuModel}</Typography>
                        </Grid>
                        <Grid item xs={6}>
                            <Typography variant="caption" color="text.secondary">Language</Typography>
                            <Typography variant="body2">{plc.language}</Typography>
                        </Grid>
                        <Grid item xs={6}>
                            <Typography variant="caption" color="text.secondary">Firmware</Typography>
                            <Typography variant="body2">{plc.firmwareVersion}</Typography>
                        </Grid>
                    </Grid>
                </CardContent>
            </Card>

            {/* Program Organization */}
            {plc.organization && (
                <Card sx={{ mb: 2 }}>
                    <CardContent>
                        <Typography variant="subtitle1" fontWeight="bold" gutterBottom>📁 Program Organization</Typography>
                        {plc.organization.map((block: any, idx: number) => (
                            <Box key={idx} sx={{ mb: 2, p: 2, border: '1px solid', borderColor: 'divider', borderRadius: 1 }}>
                                <Typography variant="body1" fontWeight="bold">
                                    {block.name} <Chip label={block.type} size="small" sx={{ ml: 1 }} />
                                </Typography>
                                <Typography variant="body2" color="text.secondary" sx={{ mt: 0.5 }}>
                                    {block.description}
                                </Typography>
                                {block.scanTime && (
                                    <Typography variant="caption" color="text.secondary" display="block" sx={{ mt: 0.5 }}>
                                        Scan Time: {block.scanTime}
                                    </Typography>
                                )}
                                {block.features && (
                                    <Box sx={{ mt: 1 }}>
                                        <Typography variant="caption" fontWeight="bold">Features:</Typography>
                                        <ul style={{ margin: '4px 0', paddingLeft: '20px' }}>
                                            {block.features.map((feat: string, fIdx: number) => (
                                                <li key={fIdx}>
                                                    <Typography variant="caption">{feat}</Typography>
                                                </li>
                                            ))}
                                        </ul>
                                    </Box>
                                )}
                                {block.inputs && (
                                    <Typography variant="caption" color="text.secondary" display="block">
                                        Inputs: {block.inputs.join(', ')}
                                    </Typography>
                                )}
                                {block.outputs && (
                                    <Typography variant="caption" color="text.secondary" display="block">
                                        Outputs: {block.outputs.join(', ')}
                                    </Typography>
                                )}
                                {block.size && (
                                    <Typography variant="caption" color="text.secondary" display="block">
                                        Size: {block.size}
                                    </Typography>
                                )}
                                {block.alarms && (
                                    <Typography variant="caption" color="text.secondary" display="block">
                                        Alarms: {block.alarms}
                                    </Typography>
                                )}
                            </Box>
                        ))}
                    </CardContent>
                </Card>
            )}

            {/* I/O Configuration */}
            {plc.io_configuration && (
                <Card sx={{ mb: 2 }}>
                    <CardContent>
                        <Typography variant="subtitle1" fontWeight="bold" gutterBottom>🔌 I/O Configuration</Typography>
                        <Grid container spacing={2}>
                            <Grid item xs={6}>
                                <Typography variant="caption" color="text.secondary">Digital Inputs</Typography>
                                <Typography variant="h6">{plc.io_configuration.digitalInputs}</Typography>
                            </Grid>
                            <Grid item xs={6}>
                                <Typography variant="caption" color="text.secondary">Digital Outputs</Typography>
                                <Typography variant="h6">{plc.io_configuration.digitalOutputs}</Typography>
                            </Grid>
                            <Grid item xs={6}>
                                <Typography variant="caption" color="text.secondary">Analog Inputs</Typography>
                                <Typography variant="h6">{plc.io_configuration.analogInputs}</Typography>
                            </Grid>
                            <Grid item xs={6}>
                                <Typography variant="caption" color="text.secondary">Analog Outputs</Typography>
                                <Typography variant="h6">{plc.io_configuration.analogOutputs}</Typography>
                            </Grid>
                            <Grid item xs={6}>
                                <Typography variant="caption" color="text.secondary">Profibus Devices</Typography>
                                <Typography variant="h6">{plc.io_configuration.profibusDevices}</Typography>
                            </Grid>
                            <Grid item xs={6}>
                                <Typography variant="caption" color="text.secondary">Profinet Devices</Typography>
                                <Typography variant="h6">{plc.io_configuration.profinetDevices}</Typography>
                            </Grid>
                        </Grid>
                    </CardContent>
                </Card>
            )}

            {/* Features */}
            {plc.features && (
                <Card>
                    <CardContent>
                        <Typography variant="subtitle1" fontWeight="bold" gutterBottom>✨ Control System Features</Typography>
                        <Grid container spacing={1}>
                            {plc.features.map((feature: string, idx: number) => (
                                <Grid item xs={6} key={idx}>
                                    <Box sx={{ p: 1, bgcolor: 'success.light', borderRadius: 1 }}>
                                        <Typography variant="body2">✔️ {feature}</Typography>
                                    </Box>
                                </Grid>
                            ))}
                        </Grid>
                    </CardContent>
                </Card>
            )}
        </Box>
    );
};

export default AmmoniaDesignWizard;
