// Compressor Node
const CompressorNode: React.FC<NodeProps> = ({ data, selected }) => (
    <Box sx={{
        padding: 2,
        borderRadius: 2,
        border: selected ? '3px solid #2563eb' : '2px solid #3b82f6',
        background: 'linear-gradient(135deg, #60a5fa 0%, #3b82f6 100%)',
        minWidth: 160,
        boxShadow: selected ? '0 8px 16px rgba(37, 99, 235, 0.4)' : '0 4px 8px rgba(59, 130, 246, 0.3)',
        color: 'white',
        position: 'relative'
    }}>
        <Handle type="target" position={Position.Left} style={{ background: '#1e40af' }} />
        <Typography variant="body2" fontWeight="bold" fontSize="0.85rem">{data.label}</Typography>
        {data.model && <Typography variant="caption" fontSize="0.7rem">Model: {data.model}</Typography>}
        {data.power && <Typography variant="caption" fontSize="0.7rem" display="block">Power: {data.power}</Typography>}
        {data.capacity && <Typography variant="caption" fontSize="0.7rem" display="block">Cap: {data.capacity}</Typography>}
        <Handle type="source" position={Position.Right} style={{ background: '#1e40af' }} />
    </Box>
);

// Valve Node - Enhanced with visual distinction
const ValveNode: React.FC<NodeProps> = ({ data, selected }) => {
    const getValveColor = (type: string) => {
        if (type?.includes('Stop') || type?.includes('SVA')) return '#ef4444';
        if (type?.includes('Check') || type?.includes('NRVA')) return '#059669';
        if (type?.includes('Solenoid') || type?.includes('EVRA')) return '#8b5cf6';
        if (type?.includes('Control') || type?.includes('ICS') || type?.includes('PM')) return '#f59e0b';
        return '#ef4444';
    };
    
    const getValveSymbol = (type: string) => {
        if (type?.includes('Stop') || type?.includes('SVA')) return '◇'; // Empty bowtie
        if (type?.includes('Check') || type?.includes('NRVA')) return '◇→'; // Bowtie with arrow
        if (type?.includes('Solenoid') || type?.includes('EVRA')) return '□◇'; // Square coil + bowtie
        if (type?.includes('Control') || type?.includes('ICS') || type?.includes('PM')) return '▲◇'; // Pilot + bowtie
        return '◇';
    };
    
    const color = getValveColor(data.valveType);
    const symbol = getValveSymbol(data.valveType);
    
    return (
        <Box sx={{
            padding: 1.5,
            borderRadius: 1.5,
            border: selected ? `3px solid ${color}` : `2px solid ${color}`,
            background: `linear-gradient(135deg, ${color}22 0%, ${color}44 100%)`,
            minWidth: 100,
            boxShadow: selected ? `0 6px 12px ${color}66` : `0 3px 6px ${color}44`,
            textAlign: 'center',
            position: 'relative'
        }}>
            <Handle type="target" position={Position.Left} style={{ background: color }} />
            <Typography variant="body2" fontWeight="bold" fontSize="0.9rem" sx={{ color }}>
                {symbol} {data.label}
            </Typography>
            {data.model && <Typography variant="caption" fontSize="0.65rem" display="block" sx={{ color: '#666' }}>{data.model}</Typography>}
            {data.valveType && <Typography variant="caption" fontSize="0.65rem" display="block" sx={{ color: '#888' }}>{data.valveType}</Typography>}
            {data.size && <Typography variant="caption" fontSize="0.7rem" display="block" fontWeight="bold" sx={{ color }}>{data.size}</Typography>}
            <Handle type="source" position={Position.Right} style={{ background: color }} />
        </Box>
    );
};

