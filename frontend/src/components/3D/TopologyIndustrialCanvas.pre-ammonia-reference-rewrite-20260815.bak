import React, { Suspense, useEffect, useMemo, useRef, useState } from 'react';
import { Canvas, useThree } from '@react-three/fiber';
import { ContactShadows, Environment, Grid, Html, OrbitControls, PerspectiveCamera } from '@react-three/drei';
import { Box, Button, Stack, Typography } from '@mui/material';
import * as THREE from 'three';
import { buildSceneGraph, LineService, SceneEquipment, SceneGraph, ScenePipe, ScenePort, SceneSupport, Vec3 } from '../../engines/RefrigerationSceneEngine';
import { ThreeDModelFactory } from '../../engines/ThreeDModelFactory';

type ViewMode = 'overview' | 'plant' | 'walkthrough';

const SERVICE_LABEL: Record<string, string> = {
  suction: 'SUCTION', discharge: 'DISCHARGE', hotGas: 'HOT GAS', liquid: 'LIQUID', oil: 'OIL', defrost: 'DEFROST', water: 'WATER', default: 'PROCESS',
};

const SERVICE_FINISH: Record<string, { color: string; glow: string; jacket?: string }> = {
  suction: { color: '#7462d8', glow: '#342577', jacket: '#dae0e8' },
  discharge: { color: '#dc3f46', glow: '#6a1019' },
  hotGas: { color: '#ed7d31', glow: '#743008' },
  liquid: { color: '#00a6a6', glow: '#005a5a', jacket: '#cbd5d9' },
  oil: { color: '#d3a52b', glow: '#6c4b08' },
  defrost: { color: '#bd5ed2', glow: '#56205f', jacket: '#d8dce5' },
  water: { color: '#2b8cca', glow: '#0d4269' },
  default: { color: '#94a3b8', glow: '#334155' },
};

const vector = (point: Vec3) => new THREE.Vector3(point[0], point[1], point[2]);
const pointDistance = (a: Vec3, b: Vec3) => Math.hypot(a[0] - b[0], a[1] - b[1], a[2] - b[2]);

const CameraRig: React.FC<{ graph: SceneGraph; mode: ViewMode }> = ({ graph, mode }) => {
  const { camera } = useThree();
  const controls = useRef<any>(null);

  useEffect(() => {
    const scopedEquipment = mode === 'plant'
      ? graph.equipment.filter(item => item.params.roomId === 'machine-room' || /compressor|vessel|condenser/i.test(item.kind))
      : graph.equipment;
    const equipment = scopedEquipment.length ? scopedEquipment : graph.equipment;
    const scopedIds = new Set(equipment.map(item => item.id));
    const scopedPipes = mode === 'plant'
      ? graph.pipes.filter(pipe => scopedIds.has(pipe.sourceEquipmentId) && scopedIds.has(pipe.targetEquipmentId))
      : graph.pipes;
    const points = [...equipment.map(item => vector(item.position)), ...scopedPipes.flatMap(pipe => pipe.waypoints.map(vector))];
    if (!points.length) return;
    const bounds = new THREE.Box3();
    points.forEach(point => bounds.expandByPoint(point));
    const center = bounds.getCenter(new THREE.Vector3());
    const size = bounds.getSize(new THREE.Vector3());
    const span = Math.max(10, mode === 'plant' ? Math.max(size.x * 0.58, size.z * 0.58) : Math.max(size.x, size.z));
    const distance = mode === 'walkthrough' ? Math.max(12, span * 0.42) : Math.max(16, span * (mode === 'plant' ? 0.70 : 0.80));
    const position = mode === 'walkthrough'
      ? new THREE.Vector3(center.x - distance * 0.30, 2.15, center.z + distance * 0.52)
      : new THREE.Vector3(center.x + distance * 0.88, Math.max(10, center.y + distance * 0.58), center.z + distance * 0.88);
    camera.position.copy(position);
    camera.near = 0.08;
    camera.far = 350;
    (camera as THREE.PerspectiveCamera).fov = mode === 'walkthrough' ? 52 : mode === 'plant' ? 35 : 39;
    camera.updateProjectionMatrix();
    const target = mode === 'walkthrough' ? new THREE.Vector3(center.x + 2.5, 2.2, center.z - 2.0) : center;
    if (controls.current) {
      controls.current.target.copy(target);
      controls.current.update();
    } else {
      camera.lookAt(target);
    }
  }, [camera, graph, mode]);

  return <OrbitControls ref={controls} makeDefault enableDamping dampingFactor={0.075} screenSpacePanning minDistance={2.6} maxDistance={120} maxPolarAngle={Math.PI * 0.49} />;
};

const Flange: React.FC<{ point: Vec3; dn: number; direction?: Vec3; service?: LineService }> = ({ point, dn, direction = [0, 1, 0], service = 'default' }) => {
  const radius = Math.max(0.055, Math.min(0.29, dn / 790));
  const normal = vector(direction).normalize();
  const quat = new THREE.Quaternion().setFromUnitVectors(new THREE.Vector3(0, 1, 0), normal);
  const boltCount = dn >= 125 ? 10 : dn >= 80 ? 8 : 4;
  const finish = SERVICE_FINISH[service] || SERVICE_FINISH.default;
  return <group position={vector(point)} quaternion={quat}>
    <mesh castShadow receiveShadow>
      <cylinderGeometry args={[radius * 1.34, radius * 1.34, 0.07, 28]} />
      <meshStandardMaterial color="#bec7cf" metalness={0.94} roughness={0.16} />
    </mesh>
    <mesh position={[0, 0.042, 0]} castShadow>
      <cylinderGeometry args={[radius * 0.95, radius * 0.95, 0.035, 24]} />
      <meshStandardMaterial color={finish.color} metalness={0.70} roughness={0.24} emissive={finish.glow} emissiveIntensity={0.08} />
    </mesh>
    {Array.from({ length: boltCount }).map((_, index) => {
      const angle = index * Math.PI * 2 / boltCount;
      return <mesh key={index} position={[Math.cos(angle) * radius * 1.05, 0.065, Math.sin(angle) * radius * 1.05]} castShadow>
        <cylinderGeometry args={[0.018, 0.018, 0.12, 8]} />
        <meshStandardMaterial color="#1f2937" metalness={0.9} roughness={0.25} />
      </mesh>;
    })}
  </group>;
};

const PipeSegment: React.FC<{ start: Vec3; end: Vec3; pipe: ScenePipe; index: number }> = ({ start, end, pipe, index }) => {
  const a = vector(start); const b = vector(end); const direction = b.clone().sub(a); const length = direction.length();
  if (length < 0.02) return null;
  const midpoint = a.clone().add(b).multiplyScalar(0.5);
  const quaternion = new THREE.Quaternion().setFromUnitVectors(new THREE.Vector3(0, 1, 0), direction.normalize());
  const finish = SERVICE_FINISH[pipe.service] || SERVICE_FINISH.default;
  const insulated = pipe.insulation;
  // Sparse jacket bands indicate insulation sections; they are not flange joints.
  const bandCount = insulated ? Math.max(0, Math.floor(length / 3.6)) : 0;
  return <group position={midpoint} quaternion={quaternion}>
    {insulated && <mesh castShadow receiveShadow>
      <cylinderGeometry args={[pipe.radius * 1.68, pipe.radius * 1.68, Math.max(0.05, length - 0.035), 28]} />
      <meshStandardMaterial color={finish.color} metalness={0.08} roughness={0.48} transparent opacity={0.42} emissive={finish.glow} emissiveIntensity={0.05} />
    </mesh>}
    <mesh castShadow receiveShadow>
      <cylinderGeometry args={[pipe.radius, pipe.radius, length, 28]} />
      <meshStandardMaterial color={finish.color} metalness={0.84} roughness={0.20} envMapIntensity={1.35} emissive={finish.glow} emissiveIntensity={0.10} />
    </mesh>
    {Array.from({ length: bandCount }).map((_, band) => <mesh key={`${index}-band-${band}`} position={[0, -length / 2 + (band + 1) * (length / (bandCount + 1)), 0]} castShadow>
      <cylinderGeometry args={[pipe.radius * 1.73, pipe.radius * 1.73, 0.026, 24]} />
      <meshStandardMaterial color="#aeb9c6" metalness={0.58} roughness={0.38} />
    </mesh>)}
  </group>;
};

const ProcessPipe: React.FC<{ pipe: ScenePipe }> = ({ pipe }) => {
  const finish = SERVICE_FINISH[pipe.service] || SERVICE_FINISH.default;
  const midPoint = pipe.waypoints[Math.floor(pipe.waypoints.length / 2)];
  return <group name={`process-line-${pipe.id}`}>
    {pipe.waypoints.slice(0, -1).map((start, index) => <PipeSegment key={`${pipe.id}-segment-${index}`} start={start} end={pipe.waypoints[index + 1]} pipe={pipe} index={index} />)}
    {pipe.waypoints.slice(1, -1).map((point, index) => <group key={`${pipe.id}-elbow-${index}`} position={vector(point)}>
      <mesh castShadow receiveShadow>
        <sphereGeometry args={[pipe.insulation ? pipe.radius * 1.71 : pipe.radius * 1.18, 22, 18]} />
        <meshStandardMaterial color={finish.color} metalness={0.70} roughness={0.25} transparent={pipe.insulation} opacity={pipe.insulation ? 0.62 : 1} emissive={finish.glow} emissiveIntensity={0.07} />
      </mesh>
    </group>)}
    {pipe.waypoints.length > 4 && <Html position={vector([midPoint[0], midPoint[1] + 0.30, midPoint[2]])} center distanceFactor={8.5} style={{ pointerEvents: 'none' }}>
      <div style={{ color: '#f8fafc', background: 'rgba(15,23,42,.92)', border: `1px solid ${finish.color}`, borderRadius: 2, padding: '3px 6px', fontSize: 9, fontWeight: 900, letterSpacing: .45, whiteSpace: 'nowrap', boxShadow: `0 0 10px ${finish.glow}` }}>
        {SERVICE_LABEL[pipe.service]} · DN{pipe.dn}
      </div>
    </Html>}
  </group>;
};

const SmallGauge: React.FC<{ position: [number, number, number] }> = ({ position }) => <group position={position}>
  <mesh rotation={[Math.PI / 2, 0, 0]} castShadow><cylinderGeometry args={[0.11, 0.11, 0.052, 20]} /><meshStandardMaterial color="#edf2f7" metalness={0.25} roughness={0.4} /></mesh>
  <mesh position={[0, 0, 0.031]} rotation={[Math.PI / 2, 0, 0]}><circleGeometry args={[0.078, 20]} /><meshBasicMaterial color="#172033" /></mesh>
  <mesh position={[0.018, 0, 0.036]} rotation={[0, 0, -0.45]}><boxGeometry args={[0.006, 0.055, 0.006]} /><meshBasicMaterial color="#e33f46" /></mesh>
  <mesh position={[0, -0.16, 0]} castShadow><cylinderGeometry args={[0.025, 0.025, 0.24, 10]} /><meshStandardMaterial color="#9aa8b6" metalness={0.85} roughness={0.3} /></mesh>
</group>;

const BoltSet: React.FC<{ width?: number; depth?: number }> = ({ width = 1.4, depth = 0.8 }) => <>
  {[-1, 1].flatMap(x => [-1, 1].map(z => <mesh key={`${x}-${z}`} position={[x * width / 2, 0.15, z * depth / 2]} castShadow>
    <cylinderGeometry args={[0.045, 0.045, 0.09, 6]} /><meshStandardMaterial color="#0f172a" metalness={0.85} roughness={0.3} />
  </mesh>))}
</>;

const CompressorDetail: React.FC<{ family: string }> = ({ family }) => {
  const reciprocating = family === 'BIM_COMP_RECIP';
  const compressorBlue = '#315f86';
  const steel = '#8d9aa7';
  return <group>
    <mesh position={[0, 0.10, 0]} castShadow receiveShadow><boxGeometry args={[4.75, .20, 1.72]} /><meshStandardMaterial color="#263746" metalness={.87} roughness={.26} /></mesh>
    <mesh position={[0, .23, -.62]} castShadow><boxGeometry args={[4.45, .12, .15]} /><meshStandardMaterial color="#5d6d7e" metalness={.80} roughness={.28} /></mesh>
    <mesh position={[0, .23, .62]} castShadow><boxGeometry args={[4.45, .12, .15]} /><meshStandardMaterial color="#5d6d7e" metalness={.80} roughness={.28} /></mesh>
    <BoltSet width={4.2} depth={1.36} />
    <mesh position={[-.48, .83, 0]} rotation={[0, 0, Math.PI / 2]} castShadow><cylinderGeometry args={[.64, .64, 1.92, 32]} /><meshStandardMaterial color={compressorBlue} metalness={.67} roughness={.29} /></mesh>
    <mesh position={[1.42, .83, 0]} rotation={[0, 0, Math.PI / 2]} castShadow><cylinderGeometry args={[.56, .56, 1.42, 32]} /><meshStandardMaterial color="#22313f" metalness={.72} roughness={.27} /></mesh>
    {Array.from({ length: 11 }).map((_, index) => <mesh key={`motor-fin-${index}`} position={[.86 + index * .112, .83, 0]} rotation={[0, Math.PI / 2, 0]} castShadow><torusGeometry args={[.59, .022, 8, 24]} /><meshStandardMaterial color="#526575" metalness={.82} roughness={.22} /></mesh>)}
    <mesh position={[.52, .83, 0]} castShadow><boxGeometry args={[.36, .50, .74]} /><meshStandardMaterial color="#d5a323" metalness={.63} roughness={.30} /></mesh>
    <mesh position={[-1.62, 1.34, -.30]} castShadow><cylinderGeometry args={[.34, .34, 1.92, 26]} /><meshStandardMaterial color={steel} metalness={.86} roughness={.19} /></mesh>
    <mesh position={[-1.62, 2.28, -.30]} castShadow><sphereGeometry args={[.34, 24, 18]} /><meshStandardMaterial color={steel} metalness={.86} roughness={.19} /></mesh>
    <mesh position={[-1.62, .40, -.30]} castShadow><sphereGeometry args={[.34, 24, 18]} /><meshStandardMaterial color={steel} metalness={.86} roughness={.19} /></mesh>
    <mesh position={[.10, 1.52, .59]} castShadow><boxGeometry args={[.58, .70, .16]} /><meshStandardMaterial color="#1f3d58" metalness={.48} roughness={.33} /></mesh>
    <mesh position={[.10, 1.64, .69]}><boxGeometry args={[.33, .32, .012]} /><meshBasicMaterial color="#8bd3ff" /></mesh>
    <SmallGauge position={[-.72, 1.78, .58]} />
    <SmallGauge position={[-1.58, 2.22, .08]} />
    <mesh position={[-2.16, .83, 0]} rotation={[0, 0, Math.PI / 2]} castShadow><cylinderGeometry args={[.15, .15, .70, 20]} /><meshStandardMaterial color="#a8b5c1" metalness={.88} roughness={.20} /></mesh>
    {reciprocating && [-1.10, -.52, .06].map((x, i) => <group key={`cylinder-bank-${i}`} position={[x, 1.42, -.48]}>
      <mesh castShadow><cylinderGeometry args={[.23, .23, .42, 18]} /><meshStandardMaterial color="#527694" metalness={.67} roughness={.30} /></mesh>
      <mesh position={[0, .25, 0]} castShadow><boxGeometry args={[.46, .10, .34]} /><meshStandardMaterial color="#7d8c9a" metalness={.72} roughness={.28} /></mesh>
    </group>)}
  </group>;
};

const VesselDetail: React.FC = () => <group>
  <mesh position={[0, 1.24, 0]} rotation={[0, 0, Math.PI / 2]} castShadow><cylinderGeometry args={[.78, .78, 4.55, 36]} /><meshStandardMaterial color="#b8c3ca" metalness={.90} roughness={.17} /></mesh>
  {[-2.28, 2.28].map((x, i) => <mesh key={`head-${i}`} position={[x, 1.24, 0]} castShadow><sphereGeometry args={[.78, 32, 24]} /><meshStandardMaterial color="#b8c3ca" metalness={.90} roughness={.17} /></mesh>)}
  {[-1.52, -.45, .62, 1.67].map((x, i) => <mesh key={`weld-${i}`} position={[x, 1.24, 0]} rotation={[0, Math.PI / 2, 0]} castShadow><torusGeometry args={[.79, .026, 10, 32]} /><meshStandardMaterial color="#6f7e8b" metalness={.86} roughness={.22} /></mesh>)}
  {[-1.20, 1.20].map((x, i) => <group key={`saddle-${i}`} position={[x, .38, 0]}>
    <mesh castShadow><boxGeometry args={[.30, .66, 1.30]} /><meshStandardMaterial color="#344556" metalness={.86} roughness={.26} /></mesh>
    <mesh position={[0, -.34, 0]} castShadow><boxGeometry args={[.72, .10, 1.55]} /><meshStandardMaterial color="#1f2d3a" metalness={.84} roughness={.27} /></mesh>
  </group>)}
  <mesh position={[0, 2.02, 0]} castShadow><cylinderGeometry args={[.14, .14, .48, 18]} /><meshStandardMaterial color="#b4c1cc" metalness={.88} roughness={.20} /></mesh>
  <SmallGauge position={[.32, 1.92, .57]} />
  <mesh position={[-.15, 1.22, .80]} castShadow><boxGeometry args={[.60, .38, .04]} /><meshStandardMaterial color="#f8fafc" metalness={.12} roughness={.52} /></mesh>
</group>;

const ValveDetail: React.FC<{ family: string }> = ({ family }) => {
  if (family === 'BIM_VALVE_GLOBE') return <group>
    <mesh position={[0, .48, 0]} castShadow><cylinderGeometry args={[.035, .035, .55, 10]} /><meshStandardMaterial color="#8b98a5" metalness={0.86} roughness={0.24} /></mesh>
    <mesh position={[0, .78, 0]} rotation={[Math.PI / 2, 0, 0]} castShadow><torusGeometry args={[.34, .04, 10, 30]} /><meshStandardMaterial color="#d8dee7" metalness={0.84} roughness={0.26} /></mesh>
  </group>;
  if (family === 'BIM_VALVE_EXPANSION') return <group>
    <mesh position={[0, .35, 0]} castShadow><cylinderGeometry args={[.18, .18, .48, 20]} /><meshStandardMaterial color="#b98935" metalness={0.82} roughness={0.24} /></mesh>
    <mesh position={[.32, .22, 0]} rotation={[0, 0, Math.PI / 2]} castShadow><cylinderGeometry args={[.045, .045, .55, 12]} /><meshStandardMaterial color="#bfcedb" metalness={0.85} roughness={0.25} /></mesh>
  </group>;
  if (family === 'BIM_STRAINER_Y') return <group><mesh position={[.1, .25, -.05]} rotation={[0, 0, -.56]} castShadow><cylinderGeometry args={[.15, .15, .58, 16]} /><meshStandardMaterial color="#a8b5c1" metalness={0.9} roughness={0.2} /></mesh></group>;
  return <group><mesh position={[0, .24, 0]} castShadow><boxGeometry args={[.34, .26, .34]} /><meshStandardMaterial color="#718096" metalness={0.82} roughness={0.26} /></mesh></group>;
};

const HeatExchangerDetail: React.FC<{ family: string }> = ({ family }) => family === 'BIM_CONDENSER_EVAP' ? <group>
  <mesh position={[0, .08, 0]} castShadow receiveShadow><boxGeometry args={[3.34, .16, 2.28]} /><meshStandardMaterial color="#243746" metalness={.82} roughness={.27} /></mesh>
  {[-1.05, 0, 1.05].map((x, i) => <group key={`fan-${i}`} position={[x, 3.14, 0]}>
    <mesh rotation={[0, 0, 0]} castShadow><cylinderGeometry args={[.48, .48, .12, 28]} /><meshStandardMaterial color="#1f2937" metalness={.78} roughness={.24} /></mesh>
    <mesh position={[0, .08, 0]} rotation={[Math.PI / 2, 0, 0]} castShadow><torusGeometry args={[.57, .025, 10, 32]} /><meshStandardMaterial color="#aeb9c6" metalness={.88} roughness={.20} /></mesh>
    {Array.from({ length: 6 }).map((_, blade) => <mesh key={blade} position={[0, .14, 0]} rotation={[Math.PI / 2, 0, blade * Math.PI / 3]}><boxGeometry args={[.035, .80, .02]} /><meshStandardMaterial color="#5a6d7e" metalness={.78} roughness={.22} /></mesh>)}
  </group>)}
  {[-.92, -.46, 0, .46, .92].map((x, i) => <mesh key={`louvre-${i}`} position={[x, 1.45, 1.04]} rotation={[0, 0, .12]} castShadow><boxGeometry args={[.16, 1.52, .07]} /><meshStandardMaterial color="#6f8393" metalness={.76} roughness={.28} /></mesh>)}
  <mesh position={[1.64, 1.30, 0]} castShadow><boxGeometry args={[.07, 1.75, 1.40]} /><meshStandardMaterial color="#34495e" metalness={.78} roughness={.30} /></mesh>
  <mesh position={[1.70, 1.28, 0]} castShadow><boxGeometry args={[.02, 1.12, .78]} /><meshStandardMaterial color="#8fb2c9" metalness={.54} roughness={.36} /></mesh>
  {[-1.32, 1.32].map((x, i) => <group key={`condenser-leg-${i}`} position={[x, -.36, 0]}>
    <mesh castShadow><boxGeometry args={[.15, .70, 1.46]} /><meshStandardMaterial color="#475569" metalness={.84} roughness={.26} /></mesh>
    <mesh position={[0, -.39, 0]} castShadow><boxGeometry args={[.66, .10, 1.76]} /><meshStandardMaterial color="#1f2937" metalness={.80} roughness={.26} /></mesh>
  </group>)}
</group> : <group>
  {[-.78, .78].map((x, i) => <mesh key={`fan-guard-${i}`} position={[x, .61, .68]} rotation={[Math.PI / 2, 0, 0]} castShadow><torusGeometry args={[.43, .024, 10, 30]} /><meshStandardMaterial color="#64748b" metalness={0.86} roughness={0.22} /></mesh>)}
  <mesh position={[0, .10, 0]} castShadow><boxGeometry args={[2.75, .12, 1.25]} /><meshStandardMaterial color="#475569" metalness={0.82} roughness={0.28} /></mesh>
</group>;

const EquipmentDetail: React.FC<{ item: SceneEquipment }> = ({ item }) => {
  const family = item.params.proId;
  if (/BIM_COMP/.test(family)) return <CompressorDetail family={family} />;
  if (/BIM_VESSEL/.test(family)) return <VesselDetail />;
  if (/BIM_VALVE|BIM_STRAINER/.test(family)) return <ValveDetail family={family} />;
  if (/BIM_CONDENSER|BIM_EVAP/.test(family)) return <HeatExchangerDetail family={family} />;
  return null;
};

const RooftopCurb: React.FC<{ item: SceneEquipment }> = ({ item }) => <group position={[item.position[0], 6.5, item.position[2]]} rotation={[0, item.rotation || 0, 0]}>
  <mesh position={[0, .12, 0]} castShadow receiveShadow><boxGeometry args={[4.15, .24, 3.08]} /><meshStandardMaterial color="#364a5c" metalness={.65} roughness={.36} /></mesh>
  <mesh position={[0, .32, 0]} castShadow><boxGeometry args={[3.72, .18, 2.62]} /><meshStandardMaterial color="#263746" metalness={.76} roughness={.28} /></mesh>
  {[-1.48, 1.48].flatMap(x => [-.92, .92].map(z => <group key={`${x}-${z}`} position={[x, .46, z]}>
    <mesh castShadow><boxGeometry args={[.18, .72, .18]} /><meshStandardMaterial color="#526575" metalness={.82} roughness={.24} /></mesh>
    <mesh position={[0, -.40, 0]} castShadow><boxGeometry args={[.70, .10, .70]} /><meshStandardMaterial color="#111c2a" metalness={.65} roughness={.32} /></mesh>
  </group>))}
  <mesh position={[0, .80, -1.40]} castShadow><boxGeometry args={[4.72, .10, .10]} /><meshStandardMaterial color="#8ea1b2" metalness={.78} roughness={.25} /></mesh>
</group>;

const EquipmentInstance: React.FC<{ item: SceneEquipment; factory: ThreeDModelFactory }> = ({ item, factory }) => {
  const placed = useMemo(() => factory.createEquipment(item.params.proId, item.params.tag, vector(item.position), new THREE.Euler(0, item.rotation || 0, 0)), [factory, item]);
  if (!placed) return null;
  const family = item.params.proId;
  const elevation = /BIM_VESSEL/.test(family) ? 2.8 : /BIM_CONDENSER/.test(family) ? 3.55 : /BIM_COMP/.test(family) ? 2.35 : 1.7;
  return <group>
    {family === 'BIM_CONDENSER_EVAP' && <RooftopCurb item={item} />}
    <primitive object={placed.group} />
    <group position={vector(item.position)} rotation={[0, item.rotation || 0, 0]}><EquipmentDetail item={item} /></group>
    {item.ports.map((port: ScenePort) => <Flange key={`${item.id}-${port.id}`} point={port.position} dn={port.dn} direction={port.direction} service={port.service} />)}
    <Html position={[item.position[0], item.position[1] + elevation, item.position[2]]} center distanceFactor={8} style={{ pointerEvents: 'none' }}>
      <div style={{ color: '#f8fafc', background: 'rgba(15,23,42,.94)', border: '1px solid rgba(203,213,225,.82)', borderRadius: 2, padding: '3px 6px', fontSize: 10, fontWeight: 900, letterSpacing: .4, whiteSpace: 'nowrap', boxShadow: '0 3px 12px rgba(0,0,0,.35)' }}>{item.params.tag}</div>
    </Html>
  </group>;
};

const PlantSupport: React.FC<{ support: SceneSupport }> = ({ support }) => {
  const steel = <meshStandardMaterial color="#475569" metalness={0.88} roughness={0.27} />;
  if (support.kind === 'riser-clamp') return <group position={vector(support.position)}>
    <mesh rotation={[Math.PI / 2, 0, 0]} castShadow><torusGeometry args={[.22, .026, 8, 20]} />{steel}</mesh>
    <mesh position={[.34, 0, 0]} castShadow><boxGeometry args={[.45, .07, .07]} />{steel}</mesh>
  </group>;
  const width = support.width || 1.4;
  if (support.kind === 'trapeze') return <group position={[support.position[0], 0, support.position[2]]}>
    {[-width / 2, width / 2].map((x, i) => <group key={i} position={[x, support.height / 2, 0]}>
      <mesh castShadow><boxGeometry args={[.10, support.height, .10]} />{steel}</mesh>
      <mesh position={[0, support.height / 2 - .16, 0]} castShadow><boxGeometry args={[.19, .16, .19]} /><meshStandardMaterial color="#1e293b" metalness={0.84} roughness={0.26} /></mesh>
    </group>)}
    <mesh position={[0, support.height, 0]} castShadow><boxGeometry args={[width + .25, .13, .14]} />{steel}</mesh>
    <mesh position={[0, support.height - .12, 0]} castShadow><boxGeometry args={[width * .65, .06, .11]} /><meshStandardMaterial color="#94a3b8" metalness={0.86} roughness={0.22} /></mesh>
  </group>;
  return <group position={[support.position[0], 0, support.position[2]]}>
    <mesh position={[0, support.height / 2, 0]} castShadow><cylinderGeometry args={[.037, .037, support.height, 10]} />{steel}</mesh>
    <mesh position={[0, support.height, 0]} castShadow><boxGeometry args={[width, .10, .11]} />{steel}</mesh>
  </group>;
};

const RoomShell: React.FC<{ room: SceneGraph['rooms'][number] }> = ({ room }) => {
  const cold = room.type === 'cold-room';
  const floor = cold ? '#294a62' : '#2d3748';
  const wall = cold ? '#7ca8bb' : '#64748b';
  return <group position={[room.center[0], 0, room.center[2]]}>
    <mesh receiveShadow position={[0, -.05, 0]}><boxGeometry args={[room.width, .10, room.depth]} /><meshStandardMaterial color={floor} metalness={.14} roughness={.72} transparent opacity={.50} /></mesh>
    {[-1, 1].map((side, i) => <mesh key={`wall-x-${i}`} position={[side * room.width / 2, room.height / 2, 0]} castShadow><boxGeometry args={[.08, room.height, room.depth]} /><meshStandardMaterial color={wall} metalness={.22} roughness={.54} transparent opacity={.18} /></mesh>)}
    {[-1, 1].map((side, i) => <mesh key={`wall-z-${i}`} position={[0, room.height / 2, side * room.depth / 2]} castShadow><boxGeometry args={[room.width, room.height, .08]} /><meshStandardMaterial color={wall} metalness={.22} roughness={.54} transparent opacity={.18} /></mesh>)}
    <Html position={[0, Math.max(.45, room.height * .55), -room.depth / 2 + .35]} center distanceFactor={10} style={{ pointerEvents: 'none' }}>
      <div style={{ color: cold ? '#b9e8ff' : '#e2e8f0', fontSize: 11, fontWeight: 900, letterSpacing: 1.1, whiteSpace: 'nowrap', textShadow: '0 1px 4px #000' }}>{room.name.toUpperCase()}</div>
    </Html>
  </group>;
};

const ServiceLegend: React.FC = () => <Stack direction="row" spacing={1.0} flexWrap="wrap" sx={{ mt: .8, maxWidth: 430 }}>
  {(['suction', 'discharge', 'hotGas', 'liquid', 'oil'] as LineService[]).map(service => <Box key={service} sx={{ display: 'flex', alignItems: 'center', gap: .45 }}>
    <Box sx={{ width: 9, height: 9, borderRadius: '50%', bgcolor: SERVICE_FINISH[service].color, boxShadow: `0 0 8px ${SERVICE_FINISH[service].color}` }} />
    <Typography variant="caption" sx={{ color: '#cbd5e1', fontSize: 9, fontWeight: 800 }}>{SERVICE_LABEL[service]}</Typography>
  </Box>)}
</Stack>;

const TopologyIndustrialCanvas: React.FC<any> = ({ data, projectInfo }) => {
  const factory = useMemo(() => new ThreeDModelFactory(), []);
  const graph = useMemo(() => buildSceneGraph(data), [data]);
  const visibleSupports = useMemo<SceneSupport[]>(() => {
    if (graph.supports.length) return graph.supports;
    return graph.pipes.map(pipe => {
      const segment = pipe.waypoints.slice(0, -1).map((a, index) => ({ a, b: pipe.waypoints[index + 1] }))
        .filter(candidate => Math.abs(candidate.a[1] - candidate.b[1]) < .05 && candidate.a[1] > 2.2)
        .sort((a, b) => pointDistance(b.a, b.b) - pointDistance(a.a, a.b))[0];
      if (!segment) return null;
      const point: Vec3 = [(segment.a[0] + segment.b[0]) / 2, segment.a[1], (segment.a[2] + segment.b[2]) / 2];
      return { id: `${pipe.id}-review-support`, kind: point[1] >= 3.5 ? 'trapeze' : 'hanger', position: [point[0], 0, point[2]], pipeId: pipe.id, height: point[1], width: Math.max(1.25, pipe.radius * 8 + .9), span: 0 } as SceneSupport;
    }).filter(Boolean) as SceneSupport[];
  }, [graph]);
  const [viewMode, setViewMode] = useState<ViewMode>('plant');
  const isEmpty = graph.equipment.length === 0;
  const gridSize = Math.max(40, graph.room.width + 12, graph.room.depth + 12);

  useEffect(() => () => factory.dispose(), [factory]);

  return <Box sx={{ width: '100%', height: '100%', minHeight: 620, position: 'relative', overflow: 'hidden', bgcolor: '#080f1c' }} data-engine="pid-topology-bim-professional">
    <Canvas shadows dpr={[1, 2]} gl={{ antialias: true, toneMapping: THREE.ACESFilmicToneMapping, toneMappingExposure: 1.35 }}>
      <PerspectiveCamera makeDefault position={[18, 13, 20]} fov={39} />
      <CameraRig graph={graph} mode={viewMode} />
      <color attach="background" args={['#080f1c']} />
      <fog attach="fog" args={['#080f1c', 40, 140]} />
      <ambientLight intensity={0.62} />
      <directionalLight position={[22, 30, 14]} intensity={1.75} castShadow shadow-mapSize={[2048, 2048]} shadow-bias={-.0002} />
      <directionalLight position={[-18, 13, -18]} intensity={0.48} color="#9bc7ff" />
      <pointLight position={[0, 8, 0]} intensity={13} distance={35} color="#dceeff" />
      <hemisphereLight args={['#adcff6', '#06101d', .48]} />
      <Suspense fallback={null}><Environment preset="warehouse" /></Suspense>
      <Grid args={[gridSize, gridSize]} sectionSize={5} sectionThickness={1.05} sectionColor="#42536d" cellColor="#1a293d" cellThickness={.55} fadeDistance={110} position={[0, -.065, 0]} />
      <ContactShadows position={[0, 0, 0]} scale={gridSize} blur={2.6} far={34} opacity={.52} />
      {graph.rooms.map(room => <RoomShell key={room.id} room={room} />)}
      {isEmpty ? <Html center><div style={{ color: '#f8fafc', fontWeight: 800 }}>No P&amp;ID equipment data available for professional BIM conversion.</div></Html> : <group>
        {graph.equipment.map(item => <EquipmentInstance key={item.id} item={item} factory={factory} />)}
        {graph.pipes.map(pipe => <ProcessPipe key={pipe.id} pipe={pipe} />)}
      </group>}
      {visibleSupports.map(support => <PlantSupport key={support.id} support={support} />)}
    </Canvas>
    <Box sx={{ position: 'absolute', top: 14, left: 14, pointerEvents: 'none', bgcolor: 'rgba(8,15,28,.88)', border: '1px solid rgba(136,170,207,.52)', px: 1.3, py: .95, boxShadow: '0 8px 24px rgba(0,0,0,.25)' }}>
      <Typography variant="caption" sx={{ display: 'block', color: '#76d5ff', fontWeight: 900, letterSpacing: 1.05 }}>P&amp;ID TO BIM · PROFESSIONAL ROUTING</Typography>
      <Typography variant="body2" sx={{ color: '#f8fafc', fontWeight: 800 }}>{projectInfo?.projectName || data?.project?.name || 'Refrigeration Design'}</Typography>
      <Typography variant="caption" sx={{ color: '#cbd5e1' }}>{graph.meta.refrigerant} · {graph.meta.cycle} · {graph.equipment.length} assets · {graph.pipes.length} process lines · {visibleSupports.length} supports</Typography>
      <Typography variant="caption" sx={{ display: 'block', mt: .45, color: graph.meta.engineeringReadiness.state === 'review-ready' ? '#86efac' : '#fbbf24', fontWeight: 800, fontSize: 9 }}>
        ENGINEERING REVIEW: {graph.meta.engineeringReadiness.state === 'review-ready' ? 'INPUT SET READY FOR REVIEW' : `INPUTS REQUIRED — ${graph.meta.engineeringReadiness.missing.join(' · ')}`}
      </Typography>
      <ServiceLegend />
    </Box>
    <Stack direction="row" spacing={.6} sx={{ position: 'absolute', right: 12, bottom: 12, bgcolor: 'rgba(8,15,28,.84)', border: '1px solid rgba(136,170,207,.42)', p: .65 }}>
      {([['overview', 'Overview'], ['plant', 'Plant'], ['walkthrough', 'Walk-through']] as [ViewMode, string][]).map(([key, label]) => <Button key={key} size="small" onClick={() => setViewMode(key)} sx={{ minWidth: 0, px: .9, py: .35, textTransform: 'none', color: viewMode === key ? '#06101d' : '#dbeafe', bgcolor: viewMode === key ? '#76d5ff' : 'transparent', fontWeight: 800, fontSize: 11, '&:hover': { bgcolor: viewMode === key ? '#b7ebff' : 'rgba(118,213,255,.12)' } }}>{label}</Button>)}
    </Stack>
  </Box>;
};

export default TopologyIndustrialCanvas;
